edition ObjectiveBend 1
# Objective Bend Standard Library (`stdlib/usd/ScenePrim.obend`)
# OpenUSD LIVRPS scene primitive importing `stdlib/core/Cell.obend` with open-recursive transform & LOD layers.

import ./Cell.obend as Cell

law monotone_frame: monotone(frame)

record UsdScenePrim:
  localOffsetMm() -> Nat
  lodBias() -> Nat
  worldTransformMm(parentMm: Nat) -> Nat
  voxelStepCost(voxels: Nat) -> Nat

spec SubLayerPrimSpec for UsdScenePrim:
  requires localOffsetMm() -> Nat
  requires lodBias() -> Nat
  def localOffsetMm() -> Nat:
    15n
  def lodBias() -> Nat:
    Cell.baseCell().epoch + 3n
  def worldTransformMm(parentMm: Nat) -> Nat:
    parentMm + self.localOffsetMm
  def voxelStepCost(voxels: Nat) -> Nat:
    voxels * self.lodBias
  # A shared local offset preserves the order of parent placements: prims nested under parents at
  # `p1 <= p2` keep that order in world space (no z-fighting inversion from a common xformOp).
  claim world_transform_open_recursion(p1: Nat, p2: Nat, offMm: Nat) given p1 <= p2 by judge("groebner@1"): p1 + offMm <= p2 + offMm
  # xformOp stack composition: applying a local scale-translate `(sL, tL)` and then the parent's
  # `(sP, tP)` is the single scale-translate `(sP * sL, sP * tL + tP)`, so a prim's local-to-world
  # transform can be flattened once per layer stack instead of per point.
  claim usd_xform_stack_composes_affinely(x: Nat, sL: Nat, tL: Nat, sP: Nat, tP: Nat) by judge("groebner@1"): sP * (sL * x + tL) + tP == (sP * sL) * x + (sP * tL + tP)

spec LocalOpinionOverride for UsdScenePrim:
  requires voxelStepCost(voxels: Nat) -> Nat
  def localOffsetMm() -> Nat:
    40n
  def voxelStepCost(voxels: Nat) -> Nat:
    super.voxelStepCost(voxels) + 8n
  claim livrps_local_opinion_overrides_sublayer() by weave: self.worldTransformMm(100n) == 140n

def seedPrim() -> UsdScenePrim:
  {localOffsetMm: 0n, lodBias: 0n, worldTransformMm: fn(p: Nat) -> Nat: p, voxelStepCost: fn(v: Nat) -> Nat: v}

def subLayerPrim() -> UsdScenePrim:
  fix(SubLayerPrimSpec, seedPrim())

def composedUsdPrim() -> UsdScenePrim:
  fix(compose(SubLayerPrimSpec, LocalOpinionOverride), seedPrim())

def composedWorldTransformAt100() -> Nat:
  composedUsdPrim().worldTransformMm(100n)

def composedVoxelCostAt5() -> Nat:
  composedUsdPrim().voxelStepCost(5n)
