edition ObjectiveBend 1
# Physical Standard Library (`stdlib/physical/Ms350FcmlPhaseLeg.obend`):
# MS350 7-Level Flying-Capacitor Multilevel (FCML) SiC Half-Bridge Phase Leg
# with Deadtime & Slew-Rate Shoot-Through Protection Override.

record Ms350PhaseLeg:
  deadtimeNs() -> Nat
  slewRateLimitVPerNs() -> Nat
  shootThroughSafe(diDt: Nat) -> Bool
  switchingLossUj(currentA: Nat) -> Nat
  effectiveGateDelayNs(marginNs: Nat) -> Nat

spec SicBaseSwitch for Ms350PhaseLeg:
  requires deadtimeNs() -> Nat
  requires slewRateLimitVPerNs() -> Nat
  def deadtimeNs() -> Nat:
    40n
  def slewRateLimitVPerNs() -> Nat:
    50n
  def shootThroughSafe(diDt: Nat) -> Bool:
    diDt <= self.slewRateLimitVPerNs
  def switchingLossUj(currentA: Nat) -> Nat:
    currentA * 3n + self.deadtimeNs
  def effectiveGateDelayNs(marginNs: Nat) -> Nat:
    marginNs + 12n
  # Across the 350 A continuous phase-current envelope, protected 120 ns deadtime switching energy
  # stays bounded below 1.2 mJ (`currentA * 3 + 120 <= 1170` uJ).
  claim protected_sic_switching_loss_bound(currentA: Nat) given currentA <= 350n by judge("interval@1"): currentA * 3n + 120n <= 1170n
  # 6-cell FCML voltage-stress reduction: the six cell voltages sum to the DC bus, and the total
  # capacitive switching stress `sum v_i^2` is at least `V_bus^2 / 6`, with equality exactly when the
  # flying capacitors are balanced. Any imbalance raises the stress above the balanced 6x reduction
  # (`(v1 + ... + v6)^2 <= 6 * (v1^2 + ... + v6^2)`).
  claim fcml_6cell_voltage_stress_reduction(v1: Nat, v2: Nat, v3: Nat, v4: Nat, v5: Nat, v6: Nat) by judge("groebner@1"): (v1 + v2 + v3 + v4 + v5 + v6) * (v1 + v2 + v3 + v4 + v5 + v6) <= 6n * (v1 * v1 + v2 * v2 + v3 * v3 + v4 * v4 + v5 * v5 + v6 * v6)

spec DeadtimeProtectionOverride for Ms350PhaseLeg:
  requires effectiveGateDelayNs(marginNs: Nat) -> Nat
  def deadtimeNs() -> Nat:
    120n
  def slewRateLimitVPerNs() -> Nat:
    80n
  def effectiveGateDelayNs(marginNs: Nat) -> Nat:
    super.effectiveGateDelayNs(marginNs) + 25n
  claim deadtime_override_updates_switching_loss() by weave: self.switchingLossUj(100n) == 420n

def seedSicSwitch() -> Ms350PhaseLeg:
  {deadtimeNs: 0n, slewRateLimitVPerNs: 0n, shootThroughSafe: fn(d: Nat) -> Bool: false, switchingLossUj: fn(i: Nat) -> Nat: 0n, effectiveGateDelayNs: fn(m: Nat) -> Nat: 0n}

def sicBasePhaseLeg() -> Ms350PhaseLeg:
  fix(SicBaseSwitch, seedSicSwitch())

def ms350ProtectedPhaseLeg() -> Ms350PhaseLeg:
  fix(compose(SicBaseSwitch, DeadtimeProtectionOverride), seedSicSwitch())

def ms350LossAt100A() -> Nat:
  ms350ProtectedPhaseLeg().switchingLossUj(100n)

def ms350GateDelayAt10Ns() -> Nat:
  ms350ProtectedPhaseLeg().effectiveGateDelayNs(10n)
