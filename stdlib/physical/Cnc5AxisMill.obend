edition ObjectiveBend 1
# Physical Standard Library (`stdlib/physical/Cnc5AxisMill.obend`):
# 5-Axis CNC Machine-Tool Metatheory with Coupled Servo Tracking Lag,
# Cantilever End-Mill Deflection, and 21-Parameter Abbe Volumetric Error Compensation.

record Cnc5AxisMill:
  servoLagUm(feedVelocityMmPerSec: Nat) -> Nat
  endMillDeflectionUm(cuttingForceHundredN: Nat) -> Nat
  abbeAngularDriftUm(cantileverArmDm: Nat) -> Nat
  commandedAxisAt10mmUm(cantileverArmDm: Nat) -> Nat
  totalVolumetricErrorUm(cantileverArmDm: Nat) -> Nat

spec Uncompensated5AxisMill for Cnc5AxisMill:
  requires servoLagUm(feedVelocityMmPerSec: Nat) -> Nat
  requires endMillDeflectionUm(cuttingForceHundredN: Nat) -> Nat
  requires abbeAngularDriftUm(cantileverArmDm: Nat) -> Nat
  def servoLagUm(feedVelocityMmPerSec: Nat) -> Nat:
    feedVelocityMmPerSec * 5n
  def endMillDeflectionUm(cuttingForceHundredN: Nat) -> Nat:
    cuttingForceHundredN * 6n
  def abbeAngularDriftUm(cantileverArmDm: Nat) -> Nat:
    cantileverArmDm * 4n
  def commandedAxisAt10mmUm(cantileverArmDm: Nat) -> Nat:
    10000n
  def totalVolumetricErrorUm(cantileverArmDm: Nat) -> Nat:
    self.servoLagUm(10n) + self.endMillDeflectionUm(5n) + self.abbeAngularDriftUm(cantileverArmDm)
  # Abbe + Ruckig compensation contracts the volumetric error from `80 + 4 * arm` um to `20 + arm` um.
  # Over the 10 dm cantilever envelope every compensated pose (`armComp`) is at least 50 um better
  # than every uncompensated pose (`armRaw`), including the uncompensated mill at zero arm.
  claim abbe_ruckig_error_contraction(armComp: Nat, armRaw: Nat) given armComp <= 10n && armRaw <= 10n by judge("interval@1"): 20n + armComp + 50n <= 80n + 4n * armRaw
  # Error-budget stack-up: the worst-case linear sum of two error sources (servo lag and Abbe drift)
  # is at most sqrt(2) times their root-sum-square (`(e1 + e2)^2 <= 2 * (e1^2 + e2^2)`).
  claim linear_stackup_within_sqrt2_of_rss(eServoUm: Nat, eAbbeUm: Nat) by judge("groebner@1"): (eServoUm + eAbbeUm) * (eServoUm + eAbbeUm) <= 2n * (eServoUm * eServoUm + eAbbeUm * eAbbeUm)

spec AbbeAndRuckigCompensatedMill for Cnc5AxisMill:
  requires commandedAxisAt10mmUm(cantileverArmDm: Nat) -> Nat
  requires abbeAngularDriftUm(cantileverArmDm: Nat) -> Nat
  def servoLagUm(feedVelocityMmPerSec: Nat) -> Nat:
    feedVelocityMmPerSec * 1n
  def endMillDeflectionUm(cuttingForceHundredN: Nat) -> Nat:
    cuttingForceHundredN * 2n
  def abbeAngularDriftUm(cantileverArmDm: Nat) -> Nat:
    cantileverArmDm * 1n
  def commandedAxisAt10mmUm(cantileverArmDm: Nat) -> Nat:
    super.commandedAxisAt10mmUm(cantileverArmDm) + super.abbeAngularDriftUm(cantileverArmDm)
  claim compensated_mill_contracts_volumetric_error() by weave: self.totalVolumetricErrorUm(6n) == 26n
  claim compensated_precompensates_uncompensated_abbe() by weave: self.commandedAxisAt10mmUm(6n) == 10024n

def seedMill() -> Cnc5AxisMill:
  {servoLagUm: fn(v: Nat) -> Nat: 0n, endMillDeflectionUm: fn(f: Nat) -> Nat: 0n, abbeAngularDriftUm: fn(arm: Nat) -> Nat: 0n, commandedAxisAt10mmUm: fn(arm: Nat) -> Nat: 10000n, totalVolumetricErrorUm: fn(arm: Nat) -> Nat: 0n}

def raw5AxisMill() -> Cnc5AxisMill:
  fix(Uncompensated5AxisMill, seedMill())

def compensated5AxisMill() -> Cnc5AxisMill:
  fix(compose(Uncompensated5AxisMill, AbbeAndRuckigCompensatedMill), seedMill())

def uncompensatedErrorAt6Dm() -> Nat:
  raw5AxisMill().totalVolumetricErrorUm(6n)

def compensatedErrorAt6Dm() -> Nat:
  compensated5AxisMill().totalVolumetricErrorUm(6n)

def compensatedCommandAt6Dm() -> Nat:
  compensated5AxisMill().commandedAxisAt10mmUm(6n)
