/-- [obend_keccak::{obend_keccak::Kmac256}::finalize_bits]:
    Source: 'crates/obend-keccak/src/lib.rs', lines 644:4-659:5
    Visibility: public -/
def Kmac256.finalize_bits
  (self : Kmac256) (out : Slice Std.U8) (bits : Std.U64) :
  Result (Slice Std.U8)
  := do
  let i := Slice.len out
  let out_bytes ← lift (UScalar.cast .U64 i)
  let needed ←
    if bits = 0#u64
    then ok 0#u64
    else do
         let i1 ← bits - 1#u64
         let i2 ← i1 / 8#u64
         i2 + 1#u64
  let i1 ← lift (UScalar.cast .Usize out_bytes)
  let i2 := Slice.len out
  massert (i1 = i2)
  massert (out_bytes = needed)
  let ks ← KeccakSponge.absorb_right_encode self bits
  let (_, out1) ← KeccakSponge.squeeze ks out
  let spare ← bits % 8#u64
  if spare != 0#u64
  then
    let i3 := Slice.len out1
    let last_idx ← i3 - 1#usize
    let i4 ← lift (UScalar.cast .U32 spare)
    let i5 ← 1#u16 <<< i4
    let i6 ← i5 - 1#u16
    let mask ← lift (UScalar.cast .U8 i6)
    let i7 ← Slice.index_usize out1 last_idx
    let i8 ← lift (i7 &&& mask)
    Slice.update out1 last_idx i8
  else ok out1

