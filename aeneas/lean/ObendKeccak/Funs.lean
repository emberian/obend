def kmac256_32
  (key : Slice Std.U8) (customization : Slice Std.U8) (message : Slice Std.U8)
  :
  Result (Array Std.U8 32#usize)
  := do
  let mac ← Kmac256.new key customization
  let mac1 ← Kmac256.absorb mac message
  let tag := Array.repeat 32#usize 0#u8
  let (s, to_slice_mut_back) ← lift (Array.to_slice_mut tag)
  let s1 ← Kmac256.finalize mac1 s
  ok (to_slice_mut_back s1)

