#!/usr/bin/env bash
# Obend Grain Worker Launcher with Bubblewrap Confinement
# Based on minidregg/deploy/grain-host/bwrap
set -euo pipefail

launcher_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
launch_gate=$launcher_dir/launch-gate

if [[ $# == 1 && $1 == --launch-gate-protocol ]]; then
  printf 'obend-grain-launch-gate-v1\n'
  exit 0
fi

if [[ $# == 1 && $1 == --controller-manager-protocol ]]; then
  printf 'obend-controller-manager-v1\n'
  exit 0
fi

[[ -x $launch_gate ]] || { echo "launch-gate executable absent: $launch_gate" >&2; exit 66; }

gate_protocol=$("$launch_gate" --launch-gate-protocol) || {
  echo 'launch-gate protocol check failed' >&2
  exit 66
}
[[ $gate_protocol == obend-grain-launch-gate-v1 ]] || {
  echo 'launch-gate protocol mismatch' >&2
  exit 66
}

usage() {
  echo 'usage: bwrap --workspace ABS_DIR --runtime-root ABS_DIR --network none|host -- /agent/PROGRAM [ARG...]' >&2
  exit 64
}

[[ $# -ge 8 && $1 == --workspace ]] || usage
workspace=$2
shift 2
[[ $# -ge 6 && $1 == --runtime-root ]] || usage
runtime_root=$2
shift 2
[[ $# -ge 4 && $1 == --network ]] || usage
network=$2
shift 2
[[ $1 == -- ]] || usage
shift
[[ $# -ge 1 ]] || usage

[[ $workspace == /* && -d $workspace && $runtime_root == /* && -d $runtime_root ]] || usage
[[ $1 == /agent/* && $1 != */../* ]] || usage
[[ $network == none || $network == host ]] || usage
workspace=$(realpath -e -- "$workspace")
runtime_root=$(realpath -e -- "$runtime_root")
[[ $workspace != / && $runtime_root != / ]] || usage

mount_roots=("$(realpath -e /usr)" "$workspace" "$runtime_root")
if [[ $network == host ]]; then
  [[ ! -d /etc/ssl ]] || mount_roots+=("$(realpath -e /etc/ssl)")
  [[ ! -f /etc/resolv.conf ]] || mount_roots+=("$(realpath -e /etc/resolv.conf)")
fi

# Secret Leak Defense: Refuse any mount exposing controller keys or state
for secret in "${OBEND_GRAIN_STATE_DIR:?controller state path required}" \
              "${OBEND_GRAIN_CUSTODY_KEY:?controller key path required}" \
              "${OBEND_GRAIN_TASK_CONFIG:?task config path required}" \
              "${OBEND_GRAIN_HOST_CONFIG:?host config path required}" \
              "${OBEND_GRAIN_CREDENTIAL_BROKER:-}"; do
  [[ -n $secret ]] || continue
  [[ $secret == /* ]] || usage
  secret=$(realpath -e -- "$secret")
  for mount in "${mount_roots[@]}"; do
    if [[ $secret == "$mount" || $secret == "$mount"/* ]]; then
      echo "controller secret or state is exposed by worker mount: $mount" >&2
      exit 77
    fi
  done
done

broker_socket=${OBEND_GRAIN_BROKER_SOCKET:-}
if [[ -n $broker_socket ]]; then
  [[ $broker_socket == /* && -S $broker_socket ]] || usage
  broker_socket=$(realpath -e -- "$broker_socket")
fi

[[ ${OBEND_GRAIN_UNIT:-} =~ ^obend-grain-t[0-9]+-o[0-9]+$ ]] || {
  echo 'OBEND_GRAIN_UNIT must identify one reserved Obend operation' >&2
  exit 64
}

runtime_max_sec=${OBEND_GRAIN_RUNTIME_MAX_SEC:-600}
[[ $runtime_max_sec =~ ^[1-9][0-9]*$ && ${#runtime_max_sec} -le 4 ]] || exit 64
(( runtime_max_sec <= 1800 )) || exit 64

scratch_mib=${OBEND_GRAIN_SCRATCH_MIB:-}
memory_max=${OBEND_GRAIN_MEMORY_MAX:-2G}
tasks_max=${OBEND_GRAIN_TASKS_MAX:-128}
cpu_weight=${OBEND_GRAIN_CPU_WEIGHT:-}
cpu_quota=${OBEND_GRAIN_CPU_QUOTA:-}

unit=${OBEND_GRAIN_UNIT}.service
controller_unit=${OBEND_GRAIN_CONTROLLER_UNIT:-}
if [[ -n $controller_unit ]]; then
  [[ $controller_unit =~ ^obend-grain-controller@([0-9]+)\.service$ ]] || usage
  [[ ${OBEND_GRAIN_UNIT} == obend-grain-t${BASH_REMATCH[1]}-o* ]] || usage
fi

# Refuse existing unit
if unit_load_state=$(systemctl --user show -p LoadState --value "$unit" 2>/dev/null); then
  if [[ $unit_load_state != not-found ]]; then
    echo "unit already exists: $unit ($unit_load_state)" >&2
    exit 73
  fi
fi

sandbox=(
  /usr/bin/bwrap --die-with-parent --unshare-user --unshare-pid
  --unshare-ipc --unshare-uts --unshare-cgroup --clearenv
  --ro-bind /usr /usr --symlink usr/bin /bin --symlink usr/lib /lib
  --symlink usr/lib64 /lib64 --dev /dev --proc /proc
  --ro-bind "$runtime_root" /agent --bind "$workspace" /workspace
  --chdir /workspace --setenv HOME /workspace --setenv PATH /usr/bin:/bin
  --hostname sandbox
)

if [[ -n $scratch_mib ]]; then
  sandbox+=(--disable-userns --cap-drop ALL --new-session
    --size 16777216 --tmpfs /tmp --size $(( 10#$scratch_mib * 1048576 )) --tmpfs /scratch)
else
  sandbox+=(--tmpfs /tmp)
fi

[[ -z $broker_socket ]] || sandbox+=(--dir /run --ro-bind "$broker_socket" /run/obend-grain.sock)

if [[ $network == none ]]; then
  sandbox+=(--unshare-net)
else
  sandbox+=(--share-net)
  [[ ! -d /etc/ssl ]] || sandbox+=(--ro-bind /etc/ssl /etc/ssl)
  [[ ! -f /etc/resolv.conf ]] || sandbox+=(--ro-bind /etc/resolv.conf /etc/resolv.conf)
fi

sandbox+=(-- "$@")

runner_pid=
stop_unit() {
  trap - TERM INT HUP
  [[ -z $runner_pid ]] || kill -TERM "$runner_pid" 2>/dev/null || :
  systemctl --user kill --signal=SIGKILL --kill-whom=all "$unit" >/dev/null 2>&1 || :
  [[ -z $runner_pid ]] || wait "$runner_pid" 2>/dev/null || :
  systemctl --user stop "$unit" >/dev/null 2>&1 || :
  exit 143
}
trap stop_unit TERM INT HUP

unit_properties=(
  --property=KillMode=control-group "--property=RuntimeMaxSec=${runtime_max_sec}s"
  "--property=MemoryMax=$memory_max" "--property=TasksMax=$tasks_max"
)
[[ -z $cpu_weight ]] || unit_properties+=("--property=CPUWeight=$cpu_weight")
[[ -z $cpu_quota ]] || unit_properties+=("--property=CPUQuota=${cpu_quota}%")
gate_meter=()
if [[ -n $scratch_mib ]]; then
  unit_properties+=("--property=LimitFSIZE=${scratch_mib}M")
  gate_meter=(--meter)
fi

if [[ -n $controller_unit ]]; then
  unit_properties+=("--property=BindsTo=$controller_unit")
fi

/usr/bin/systemd-run --user --wait --pipe --collect --unit="${OBEND_GRAIN_UNIT}" \
  "${unit_properties[@]}" \
  "$launch_gate" run "$OBEND_GRAIN_STATE_DIR" "$OBEND_GRAIN_UNIT" "${gate_meter[@]}" -- \
  "${sandbox[@]}" <&0 >&1 2>&2 &
runner_pid=$!
wait "$runner_pid"
