/-
# `obend-emit-sv` — regenerate every checked-in SystemVerilog file from its Lean definition

    obend-emit-sv <target> [--out FILE]      targets: risc fidget drex quantum silicon-elab mac2 ice40-mac8
                                                      tcad stator mill golden-silicon-kernel
    obend-emit-sv list

This executable lives outside the `Obend` library tier because it imports `Obend.Apps.*` (tier 2).
Each `apps/*/verilator/verify_*.sh` and `hardware/sim/verify_sim.sh` runs it and compares the result
byte-for-byte with the committed file: a `.sv` that is not reproducible from Lean is a failure, and
a file this tool does not know is hand-written and says so in its header.
-/
import Obend.Hardware.HDL
import Obend.Hardware.Synth
import Obend.Hardware.VerilateRunner
import Obend.Hardware.Cli
-- `Obend.Apps.ObendRisc` is red at HEAD (decide/omega failures from line 733 on) until the Apps gate lands;
-- the `risc` target returns then (the fpga lane owns the JAL/BLTU/x16-x31 fixes), and verify_risc.sh fails honestly meanwhile.
import Obend.Apps.FidgetCam
-- `Obend.Apps.SovereignDrex` is red at HEAD (`checkContractCert` unresolved, line 505) until the Apps gate
-- lands; the `drex` target returns to this list then and `verify_sovereign_drex.sh` fails honestly meanwhile.
import Obend.Apps.QuantumPhotonicMatter
import Obend.Apps.SiliconKernelVerilator

open Obend.Hardware.HDL

/-- Provenance header + emitted module text. The header names the Lean definition and this tool. -/
def emitWithHeader (qualified : String) (m : RtlModule) : Except String String :=
  if !checkRtlModuleW m then
    .error s!"{qualified} fails checkRtlModuleW (DAG/CDC/width/two-flop); not emitted"
  else
    .ok (s!"// Generated by Obend.Hardware.HDL.emitModuleSV from {qualified}\n" ++
         s!"// Do not edit: regenerate with `obend-emit-sv` (lean/tools/emitsv); the verify script compares bytes.\n" ++
         emitModuleSV m)

/-- The compositions `obend verilate` knows, compiled through the same path (`compileCompositionToVerifiedRtl`). -/
def builtIn (choice : String) : Except String String :=
  let (modName, comp) := Obend.Hardware.VerilateRunner.selectBuiltInComposition choice
  match Obend.Hardware.VerilateRunner.compileCompositionToVerifiedRtl modName comp with
  | some (_, m) => emitWithHeader s!"Obend.Hardware.VerilateRunner.selectBuiltInComposition \"{choice}\"" m
  | none => .error s!"built-in composition {choice} did not compile to an RtlModule"

/-- Expected values of the silicon-kernel co-simulation, from the Lean model, as `key=value` lines the
C++ harness reads (`apps/silicon-kernel-verilator/verilator/silicon_elab_golden.txt`). -/
def goldenSiliconKernel : String :=
  let t := Obend.Apps.SiliconKernelVerilator.runVerilatorCoSimModel
  "# Generated by obend-emit-sv golden-silicon-kernel from Obend.Apps.SiliconKernelVerilator.runVerilatorCoSimModel\n" ++
  s!"status={t.status}\n" ++
  s!"epoch1_lut_out={t.epoch1LutOut.toNat}\n" ++
  s!"epoch2_lut_out={t.epoch2LutOut.toNat}\n" ++
  s!"moved_pin_fallback={if t.movedPinFallback1Cyc then 1 else 0}\n" ++
  s!"dpr_glitch_free_clamped={if t.dprGlitchFreeClamped then 1 else 0}\n" ++
  s!"tooth_mutant_refused={if t.toothMutantRefused then 1 else 0}\n" ++
  s!"sorry_refused={if t.sorryRefused then 1 else 0}\n"

/-- The first physical target: an 8x8+16 multiply-accumulate with port widths, for the iCEstick
(`hardware/ice40/`). Same shape as `Synth.goldenRetimedMacRtl`; the width annotations are what let
yosys shrink the 64-bit word datapath to something an HX1K holds. -/
def iceStickMac8 : RtlModule :=
  { name       := "obend_ice40_mac8"
    inputNames := ["a", "b", "c"]
    inputWidths := [8, 8, 16]
    wires      :=
      [ { wireIdx := 0, name := "w_mul", expr := .alu .mul (.inputPort 0) (.inputPort 1) }
      , { wireIdx := 1, name := "w_add", expr := .alu .add (.regRead 0) (.regRead 1) } ]
    regs       :=
      [ { regIdx := 0, name := "mulReg", domain := .coreClk, resetKind := .syncReset 0#64, isSynchronizer := false, nextExpr := .wireRef 0 }
      , { regIdx := 1, name := "cReg",   domain := .coreClk, resetKind := .syncReset 0#64, isSynchronizer := false, nextExpr := .inputPort 2 }
      , { regIdx := 2, name := "outReg", domain := .coreClk, resetKind := .syncReset 0#64, isSynchronizer := false, nextExpr := .wireRef 1 } ]
    outputs    := [ { name := "mac_out", expr := .regRead 2, width := 16 } ] }

def targets : List (String × String) :=
  [ ("risc", "apps/obend-risc/verilator/obend_risc_cpu.sv")
  , ("fidget", "apps/fidget-cam/verilator/fidget_impeller_voxel_cam.sv")
  , ("drex", "apps/sovereign-drex/verilator/sovereign_drex_batch_top.sv")
  , ("quantum", "apps/quantum-photonic-matter/verilator/quantum_photonic_coproc_top.sv")
  , ("silicon-elab", "apps/silicon-kernel-verilator/verilator/silicon_elab_top.sv")
  , ("golden-silicon-kernel", "apps/silicon-kernel-verilator/verilator/silicon_elab_golden.txt")
  , ("mac2", "hardware/sim/obend_retimed_mac2.sv")
  , ("ice40-mac8", "hardware/ice40/obend_ice40_mac8.sv")
  , ("tcad", "hardware/sim/cleanroom_tcad_stack.sv")
  , ("stator", "hardware/sim/lc_drives_userspace_stator.sv")
  , ("mill", "hardware/sim/cnc_5axis_userspace_mill.sv") ]

def render : String → Except String String
  | "risc"    => .error "risc: Obend.Apps.ObendRisc does not build at HEAD; target disabled until the Apps gate lands"
  | "fidget"  => emitWithHeader "Obend.Apps.FidgetCam.fidgetImpellerVoxelCamRtlModule" Obend.Apps.FidgetCam.fidgetImpellerVoxelCamRtlModule
  | "drex"    => .error "drex: Obend.Apps.SovereignDrex does not build at HEAD; target disabled until the Apps gate lands"
  | "quantum" => emitWithHeader "Obend.Apps.QuantumPhotonicMatter.quantumPhotonicCoprocTopRtlModule" Obend.Apps.QuantumPhotonicMatter.quantumPhotonicCoprocTopRtlModule
  | "silicon-elab" => .ok Obend.Hardware.Cli.siliconElabTopSvText
  | "golden-silicon-kernel" => .ok goldenSiliconKernel
  | "mac2"    => emitWithHeader "Obend.Hardware.Synth.goldenRetimedMacRtl" Obend.Hardware.Synth.goldenRetimedMacRtl
  | "ice40-mac8" => emitWithHeader "EmitSv.iceStickMac8 (lean/tools/emitsv/EmitSv.lean)" iceStickMac8
  | "tcad"    => builtIn "cleanroom_tcad_stack"
  | "stator"  => builtIn "lc_drives_userspace_stator"
  | "mill"    => builtIn "cnc_5axis_userspace_mill"
  | other     => .error s!"unknown target {other}; `obend-emit-sv list`"

def main (args : List String) : IO UInt32 := do
  match args with
  | ["list"] =>
    for (t, path) in targets do IO.println s!"{t}\t{path}"
    return 0
  | target :: rest =>
    let outPath? := match rest with | "--out" :: p :: _ => some p | _ => none
    match render target with
    | .error e => IO.eprintln s!"refused: {e}"; return 3
    | .ok text =>
      match outPath? with
      | some p => IO.FS.writeFile p text; IO.println s!"wrote {target} ({text.length} bytes) to {p}"; return 0
      | none => IO.print text; return 0
  | [] => IO.eprintln "usage: obend-emit-sv <target> [--out FILE] | obend-emit-sv list"; return 64
