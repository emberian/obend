/-
# `obend-emit-sv` — regenerate every checked-in SystemVerilog file from its Lean definition

    obend-emit-sv <target> [--out FILE]      targets: risc golden-risc zk golden-zk fidget fidget-ngc
                                                      drex quantum silicon-elab mac2
                                                      ice40-mac8 tcad stator mill golden-silicon-kernel
                                                      width-probe
    obend-emit-sv square-<graph> [--out FILE] the RTL lowering of a graph of `Obend.Hardware.SquareGraphs`
                                             (`hardware/gpu/square/`); with --tb the Verilator harness
                                             (`emitVerilatorHarnessCpp`) over the graph's vectors against
                                             the HDL model (`evalModuleOutputs`); with --expected the HDL
                                             model's `expected.tsv`, to compare with the array model's
    obend-emit-sv <target> --lec [--out FILE]  the Lean half of the LEC of an `RtlModule` target
                                             (`Obend.Hardware.YosysLec.emitYosysLecSmt2`), appended to
                                             Yosys `write_smt2` of the emitted .sv; `unsat` = equivalent
    obend-emit-sv check-risc | check-zk      the native checks the Apps modules name (gates, corners,
                                             the firmware state); exit 3 with the failing check
    obend-emit-sv list

This executable lives outside the `Obend` library tier because it imports `Obend.Apps.*` (tier 2).
Each `apps/*/verilator/verify_*.sh` and `hardware/sim/verify_sim.sh` runs it and compares the result
byte-for-byte with the committed file: a `.sv` that is not reproducible from Lean is a failure, and
a file this tool does not know is hand-written and says so in its header.
-/
import Obend.Hardware.HDL
import Obend.Hardware.Mac8
import Obend.Hardware.Fabulous.LUT4ABSwitchMatrix
import Obend.Hardware.Fabulous.WIOSwitchMatrix
import Obend.Hardware.Synth
import Obend.Hardware.VerilateRunner
import Obend.Hardware.Cli
import Obend.Hardware.YosysLec
import Obend.Hardware.SquareGraphs
import Obend.Apps.ObendRisc
import Obend.Apps.ZkNtt
import Obend.Apps.FidgetCam
import Obend.Apps.SovereignDrex
import Obend.Apps.QuantumPhotonicMatter
import Obend.Apps.SiliconKernelVerilator

open Obend.Hardware.HDL
open Obend.Hardware.SquareGraphs

/-- Provenance header + emitted module text. The header names the Lean definition and this tool. -/
def emitWithHeader (qualified : String) (m : RtlModule) : Except String String :=
  if !checkRtlModuleW m then
    .error (s!"{qualified} fails checkRtlModuleW (DAG/CDC/width/two-flop); not emitted" ++
      String.join ((widthErrors m).map fun e => s!"\n  {e}"))
  else
    .ok (s!"// Generated by Obend.Hardware.HDL.emitModuleSV from {qualified}\n" ++
         s!"// Do not edit: regenerate with `obend-emit-sv` (lean/tools/emitsv); the verify script compares bytes.\n" ++
         emitModuleSV m)

/-- The compositions `obend verilate` knows, compiled through the same path (`compileCompositionToVerifiedRtl`). -/
def builtInModule (choice : String) : Except String (String × RtlModule) :=
  let (modName, comp) := Obend.Hardware.VerilateRunner.selectBuiltInComposition choice
  match Obend.Hardware.VerilateRunner.compileCompositionToVerifiedRtl modName comp with
  | some (_, m) => .ok (s!"Obend.Hardware.VerilateRunner.selectBuiltInComposition \"{choice}\"", m)
  | none => .error s!"built-in composition {choice} did not compile to an RtlModule"

/-- Expected values of the silicon-kernel co-simulation, from the Lean model, as `key=value` lines the
C++ harness reads (`apps/silicon-kernel-verilator/verilator/silicon_elab_golden.txt`). -/
def goldenSiliconKernel : String :=
  let t := Obend.Apps.SiliconKernelVerilator.runVerilatorCoSimModel
  "# Generated by obend-emit-sv golden-silicon-kernel from Obend.Apps.SiliconKernelVerilator.runVerilatorCoSimModel\n" ++
  s!"status={t.status}\n" ++
  s!"epoch1_lut_out={t.epoch1LutOut.toNat}\n" ++
  s!"epoch2_lut_out={t.epoch2LutOut.toNat}\n" ++
  s!"moved_pin_fallback={if t.movedPinFallback1Cyc then 1 else 0}\n" ++
  s!"dpr_glitch_free_clamped={if t.dprGlitchFreeClamped then 1 else 0}\n" ++
  s!"tooth_mutant_refused={if t.toothMutantRefused then 1 else 0}\n" ++
  s!"sorry_refused={if t.sorryRefused then 1 else 0}\n"

/-- `check-risc`: the gates on both RISC cores and the recorded end state of the firmware run
(`Obend.Apps.ObendRisc.riscFirmwareExpected*`). -/
def checkRisc : Except String String :=
  let b := Obend.Apps.ObendRisc.baseRiscCpuRtlModule
  let m := Obend.Apps.ObendRisc.obendRiscCpuRtlModule
  let st := Obend.Apps.ObendRisc.riscFinalState
  let regsOk := Obend.Apps.ObendRisc.riscFirmwareExpectedRegs.all fun (slot, v) => (st.1 slot).toNat == v
  let dmemOk := Obend.Apps.ObendRisc.riscFirmwareExpectedDmem.all fun (a, v) => (st.2 a).toNat == v
  if !checkRtlModule b then .error "check-risc: base_risc_cpu fails checkRtlModule"
  else if !checkRtlModuleW m then .error "check-risc: obend_risc_cpu fails checkRtlModuleW"
  else if m.regs.length != 36 then .error s!"check-risc: {m.regs.length} registers, expected 36"
  else if !(regsOk && dmemOk) then .error "check-risc: the 21-cycle firmware run does not reach the recorded state"
  else .ok "check-risc: gates ok, 36 registers, firmware end state as recorded\n"

/-- `check-zk`: the three checks `Obend.Apps.ZkNtt` documents (gate, carry/borrow corners, one transcript round). -/
def checkZk : Except String String :=
  if !Obend.Apps.ZkNtt.zkCheckGate then .error "check-zk: zk_ntt_coproc fails checkRtlModule/checkRtlModuleW/BEL validity"
  else if !Obend.Apps.ZkNtt.zkCheckButterfly then .error "check-zk: butterfly differs from the Nat specification on a boundary vector"
  else if !Obend.Apps.ZkNtt.zkCheckTranscriptRound then .error "check-zk: one accumulate/absorb round does not match transcriptAbsorbSpec"
  else .ok s!"check-zk: gate ok ({Obend.Apps.ZkNtt.zkNttCoprocRtlModule.wires.length} wires), 6 boundary vectors, transcript round ok\n"

def targets : List (String × String) :=
  [ ("risc", "apps/obend-risc/verilator/obend_risc_cpu.sv")
  , ("golden-risc", "apps/obend-risc/verilator/risc_golden.txt")
  , ("zk", "apps/zk-ntt/verilator/zk_ntt_coproc.sv")
  , ("golden-zk", "apps/zk-ntt/verilator/zk_ntt_golden.txt")
  , ("fidget", "apps/fidget-cam/verilator/fidget_impeller_voxel_cam.sv")
  , ("fidget-ngc", "apps/fidget-cam/build/impeller_5axis.ngc")
  , ("drex", "apps/sovereign-drex/verilator/sovereign_drex_batch_top.sv")
  , ("quantum", "apps/quantum-photonic-matter/verilator/quantum_photonic_coproc_top.sv")
  , ("silicon-elab", "apps/silicon-kernel-verilator/verilator/silicon_elab_top.sv")
  , ("golden-silicon-kernel", "apps/silicon-kernel-verilator/verilator/silicon_elab_golden.txt")
  , ("mac2", "hardware/sim/obend_retimed_mac2.sv")
  , ("ice40-mac8", "hardware/ice40/obend_ice40_mac8.sv")
  , ("tcad", "hardware/sim/cleanroom_tcad_stack.sv")
  , ("stator", "hardware/sim/lc_drives_userspace_stator.sv")
  , ("mill", "hardware/sim/cnc_5axis_userspace_mill.sv")
  , ("width-probe", "hardware/sim/obend_width_probe.sv")
  , ("lut4ab-sm", "hardware/fabulous/tile/LUT4AB_switch_matrix_lec.sv")
  , ("wio-sm", "hardware/fabulous/tile/W_IO_switch_matrix_lec.sv")
  , ("lut4c", "hardware/fabulous/tile/LUT4c_frame_config_dffesr.sv")
  , ("mux8lut", "hardware/fabulous/tile/MUX8LUT_frame_config_mux.sv") ] ++
  squareGraphs.map fun sq => (s!"square-{sq.name}", s!"hardware/gpu/square/sv/{svName sq.name}.sv")

/-- `square-<graph>`: a graph of `squareGraphs`. The theorems' hypotheses (`ArrayGraph.wf` and
`SquareGraph.hyp`) are checked here, so a module this prints is one `rtl_eq_gpu`/`rtl_eq_gpu_array` is about. -/
def squareTarget (t : String) : Option (Except String SquareGraph) :=
  if t.startsWith "square-" then
    match squareGraphs.find? (fun sq => s!"square-{sq.name}" == t) with
    | some sq =>
      if !sq.graph.wf then some (.error s!"{t}: the graph fails ArrayGraph.wf")
      else if !sq.hyp then some (.error s!"{t}: the square theorem's hypothesis fails (a wire defined twice, or an edge reading its own destination)")
      else some (.ok sq)
    | none => some (.error s!"unknown square graph {t}; `obend-emit-sv list`")
  else none

/-- The targets that are one `RtlModule` printed by `emitModuleSV`: the qualified name of the Lean
definition and the module. `render` prints these with `emitWithHeader`; `--lec` prints their LEC half. -/
def moduleTarget : String → Option (Except String (String × RtlModule))
  | "risc"    => some (.ok ("Obend.Apps.ObendRisc.obendRiscCpuRtlModule", Obend.Apps.ObendRisc.obendRiscCpuRtlModule))
  | "zk"      => some (.ok ("Obend.Apps.ZkNtt.zkNttCoprocRtlModule", Obend.Apps.ZkNtt.zkNttCoprocRtlModule))
  | "fidget"  => some (.ok ("Obend.Apps.FidgetCam.fidgetImpellerVoxelCamRtlModule", Obend.Apps.FidgetCam.fidgetImpellerVoxelCamRtlModule))
  | "quantum" => some (.ok ("Obend.Apps.QuantumPhotonicMatter.quantumPhotonicCoprocTopRtlModule", Obend.Apps.QuantumPhotonicMatter.quantumPhotonicCoprocTopRtlModule))
  | "mac2"    => some (.ok ("Obend.Hardware.Synth.goldenRetimedMacRtl", Obend.Hardware.Synth.goldenRetimedMacRtl))
  | "ice40-mac8" => some (.ok ("Obend.Hardware.iceStickMac8 (lean/Obend/Hardware/Mac8.lean)", Obend.Hardware.iceStickMac8))
  | "tcad"    => some (builtInModule "cleanroom_tcad_stack")
  | "stator"  => some (builtInModule "lc_drives_userspace_stator")
  | "mill"    => some (builtInModule "cnc_5axis_userspace_mill")
  | "drex"    => some (.ok ("Obend.Apps.SovereignDrex.sovereignDrexBatchTopRtlModule", Obend.Apps.SovereignDrex.sovereignDrexBatchTopRtlModule))
  | "width-probe" => some (.ok ("Obend.Hardware.VerilateRunner.goldenWidthProbeRtl", Obend.Hardware.VerilateRunner.goldenWidthProbeRtl))
  | "lut4ab-sm" => some (.ok ("Obend.Hardware.Fabulous.smModule lut4abSwitchMatrix", Obend.Hardware.Fabulous.smModule Obend.Hardware.Fabulous.lut4abSwitchMatrix))
  | "wio-sm" => some (.ok ("Obend.Hardware.Fabulous.smModule wioSwitchMatrix", Obend.Hardware.Fabulous.smModule Obend.Hardware.Fabulous.wioSwitchMatrix))
  | "lut4c"   => some (.ok ("Obend.Hardware.Fabulous.lut4cModule", Obend.Hardware.Fabulous.lut4cModule))
  | "mux8lut" => some (.ok ("Obend.Hardware.Fabulous.mux8lutModule", Obend.Hardware.Fabulous.mux8lutModule))
  | other =>
    match squareTarget other with
    | some (.ok sq) => some (.ok (sq.lean, sq.rtl))
    | some (.error err) => some (.error err)
    | none => none

/-- The names `moduleTarget` answers, for `list` (which must not build the modules to print them). -/
def moduleTargetNames : List String :=
  ["risc", "zk", "fidget", "quantum", "drex", "mac2", "ice40-mac8", "tcad", "stator", "mill", "width-probe", "lut4ab-sm", "wio-sm", "lut4c", "mux8lut"] ++
  squareGraphs.map fun sq => s!"square-{sq.name}"

/-- `--tb`: the Verilator harness of a square target: every vector of the graph on the module's input
ports, each output port against `evalModuleOutputs` (the HDL semantics, the side `rtl_eq_gpu` is about).
One cycle per vector: the module is combinational. -/
def renderSquareTb (target : String) : Except String String :=
  match squareTarget target with
  | none => .error s!"--tb: {target} is not a square target"
  | some (.error err) => .error err
  | some (.ok sq) =>
    if !checkRtlModuleW sq.rtl then .error s!"{sq.lean} fails checkRtlModuleW; not emitted" else
    let vecs : List Obend.Hardware.VerilateRunner.DifferentialVector :=
      (graphVectors sq.graph sq.kind).zipIdx.map fun (vals, v) =>
        let ins := squareInputs vals
        { vecIdx := v
        , portInputs := sq.rtl.inputNames.zipIdx.map fun (n, p) => (n, ins p)
        , expectedOutputs := evalModuleOutputs sq.rtl ins (fun _ => 0#64)
        , machineAgreed := true }
    .ok (s!"// Generated by obend-emit-sv {target} --tb from {sq.lean}: Verilator against evalModuleOutputs\n" ++
         Obend.Hardware.VerilateRunner.emitVerilatorHarnessCpp sq.rtl vecs 1 none)

/-- `--expected`: the HDL model's `expected.tsv` of a square target (`squareExpectedTsv`). -/
def renderSquareExpected (target : String) : Except String String :=
  match squareTarget target with
  | none => .error s!"--expected: {target} is not a square target"
  | some (.error err) => .error err
  | some (.ok sq) => .ok (squareExpectedTsv sq)

/-- `--lec`: the Lean half of the LEC of a module target, behind the same emission gate as its `.sv`
(`checkRtlModuleW` includes `checkWidths`, which implies the `moduleFaithful` hypothesis of
`YosysLec.lecScript_holds_iff`: `moduleFaithful_of_checkWidths`). -/
def renderLec (target : String) : Except String String :=
  match moduleTarget target with
  | none => .error s!"--lec: {target} is not an RtlModule target (`obend-emit-sv list` marks those)"
  | some (.error e) => .error e
  | some (.ok (qualified, m)) =>
    if !checkRtlModuleW m then
      .error s!"{qualified} fails checkRtlModuleW (DAG/CDC/width/two-flop); not emitted"
    else
      .ok (s!"; Generated by obend-emit-sv {target} --lec from {qualified}\n" ++
           Obend.Hardware.YosysLec.emitYosysLecSmt2 m)

def render : String → Except String String
  -- 21 cycles of firmware/test_prog.hex on the Lean model; risc_soc_tb.cpp compares every register and dmem word.
  | "golden-risc" => .ok (Obend.Apps.ObendRisc.riscFirmwareGolden 21)
  -- The 8-round sumcheck with the transcript, run at the Nat level; zk_ntt_tb.cpp compares the RTL per round.
  | "golden-zk" => .ok Obend.Apps.ZkNtt.zkSumcheckGolden
  -- The posted program is a Lean string (`postNgc` over the certified passes); the Verilator
  -- testbench reads this file and re-checks its waypoints against the RTL, it does not write one.
  | "fidget-ngc" => .ok Obend.Apps.FidgetCam.impeller5AxisNgc
  | "quantum" => emitWithHeader "Obend.Apps.QuantumPhotonicMatter.quantumPhotonicCoprocTopRtlModule" Obend.Apps.QuantumPhotonicMatter.quantumPhotonicCoprocTopRtlModule
  | "silicon-elab" => .ok Obend.Hardware.Cli.siliconElabTopSvText
  | "golden-silicon-kernel" => .ok goldenSiliconKernel
  | "check-risc" => checkRisc
  | "check-zk" => checkZk
  | other     =>
    match moduleTarget other with
    | some (.ok (qualified, m)) => emitWithHeader qualified m
    | some (.error e) => .error e
    | none => .error s!"unknown target {other}; `obend-emit-sv list`"

def main (args : List String) : IO UInt32 := do
  match args with
  | ["list"] =>
    for (t, path) in targets do
      IO.println s!"{t}\t{path}{if moduleTargetNames.contains t then "\t(RtlModule; --lec)" else ""}"
    return 0
  | target :: rest =>
    let outPath? := match rest.dropWhile (· != "--out") with | "--out" :: p :: _ => some p | _ => none
    let text? :=
      if rest.contains "--lec" then renderLec target
      else if rest.contains "--tb" then renderSquareTb target
      else if rest.contains "--expected" then renderSquareExpected target
      else render target
    match text? with
    | .error e => IO.eprintln s!"refused: {e}"; return 3
    | .ok text =>
      match outPath? with
      | some p => IO.FS.writeFile p text; IO.println s!"wrote {target} ({text.length} bytes) to {p}"; return 0
      | none => IO.print text; return 0
  | [] => IO.eprintln "usage: obend-emit-sv <target> [--out FILE] | obend-emit-sv list"; return 64
