{
var 1 entry = (state + (2 + (i * 100)));
lastId = (ld8 (entry + 3));
if ((ld8 ((scratch + 8) + 0)) == (ld8 (entry + 1))) {
spent = (spent + (ld8 (entry + 4)));
if ((ld8 ((scratch + 8) + 1)) == (ld8 (entry + 2))) {
if (width != (ld8 (entry + 0))) {
return 0;
} else {
skip;
}
{
var 1 j = 0;
