export fun turnIntake(1 src, 1 len, 1 state, 1 scratch) {
{
var 1 off = parseFrame(src, len);
if (off == 0) {
return 0;
} else {
skip;
}
{
var 1 width = (len - off);
{
var 1 copied = dn_echo((src + off), (scratch + 8), width, 99);
