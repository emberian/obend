}
if (lastId >=+ (ld8 ((scratch + 8) + 2))) {
return 0;
} else {
skip;
}
if ((ld8 ((scratch + 8) + 3)) == 0) {
return 0;
} else {
skip;
}
if (20 <+ (spent + (ld8 ((scratch + 8) + 3)))) {
