module
/-
# Obend.Hardware.Fabulous.Extract — writing `Mac8Net.lean` from a bitstream

`mac8NetLean` is the text of `Obend.Hardware.Fabulous.Mac8Net`: the `Net` a bitstream configures, the
register-to-flop correspondence found by `flopCandidates`, the correspondence's bit lemma, and the two
closed bit-level obligations, each discharged by `bv_decide`. `obend fabric extract` writes it.
-/
public import Obend.Hardware.Fabulous.Bitstream
public import Obend.Hardware.Fabulous.Mac8Ref
@[expose] public section

namespace Obend.Hardware.Fabulous

open Obend.Hardware Obend.Hardware.HDL

def conj (xs : List String) : String := " ∧\n      ".intercalate xs

/-- The text of `Mac8Net.lean` for net `N` with correspondence `fm`, read from `source`. -/
def mac8NetLean (N : Net) (fm : List (Nat × Nat)) (source : String) : String := Id.run do
  let pm := mac8Pins
  let inputPins := (List.range pm.length).filter fun k => match pm[k]? with
    | some ⟨_, _, .output _ _⟩ => false | _ => true
  let pinName (k : Nat) : String := match pm[k]? with
    | some ⟨_, _, .input p j⟩ => s!"I{p}.getLsbD {j}"
    | _ => "rst"
  let p (k : Nat) := s!"(p {k})"
  let q (k : Nat) := s!"(q {k})"
  let hp (rst : String) := conj (inputPins.map fun k =>
    s!"p {k} = " ++ (match pm[k]? with | some ⟨_, _, .reset⟩ => rst | _ => pinName k))
  let hq := conj (fm.zipIdx.map fun ((r, j), k) => s!"q {k} = R{r}.getLsbD {j}")
  let hv := gatesBV N p q ++ " ∧\n      True"
  let flops := flopsBV N p q
  let exp := "[" ++ ", ".intercalate (fm.map fun (r, j) => s!"(s {r}).getLsbD {j}") ++ "]"
  let outs := "[" ++ ", ".intercalate (N.outs.map fun (k, l) => s!"({k}, {litBV p q l})") ++ "]"
  let outExp := "[" ++ ", ".intercalate (N.outs.map fun (k, _) => s!"({k}, o {k})") ++ "]"
  let ho := conj (N.outs.map fun (k, _) => match pm[k]? with
    | some ⟨_, _, .output _ j⟩ => s!"o {k} = R2.getLsbD {j}" | _ => s!"o {k} = false")
  let projStmt := conj (fm.zipIdx.map fun ((r, j), k) => s!"projOf mac8FlopMap regs {k} = R{r}.getLsbD {j}")
  let projPrf := ",\n   ".intercalate (fm.zipIdx.map fun ((r, j), k) =>
    s!"(show projOf mac8FlopMap regs {k} = (regs {r}).getLsbD {j} from rfl).trans (by rw [hr{r}]; simp)")
  let simpSet := "simp only [lut4, mux2, List.cons.injEq, Prod.mk.injEq, and_true, true_and]"
  let mut t := "module\n/-\n# Obend.Hardware.Fabulous.Mac8Net — the logic of `" ++ source ++ "`\n\n" ++
    "Generated by `obend fabric extract` (`Obend.Hardware.Fabulous.Extract.mac8NetLean`); do not edit. `obend fabric\n" ++
    "check` refuses a bitstream that does not read back to `mac8Net`.\n\n" ++
    "`mac8_step_bv` and `mac8_reset_bv` are closed statements over the gate values `v`, one equation per\n" ++
    "gate (`hv`), with the pins `p`, flops `q`, expected next registers `s` and expected outputs `o` tied to\n" ++
    "the module's bits; `bv_decide` discharges them (its LRAT check is compiled evaluation,\n" ++
    "re-run by `#assert_compiled`). `Obend.Hardware.Fabulous.Mac8` instantiates them.\n-/\n" ++
    "public import Obend.Hardware.Fabulous.Mac8Ref\npublic import Obend.AssertCompiled\n" ++
    "public import Std.Tactic.BVDecide\npublic meta import Std.Tactic.BVDecide.Reflect\n@[expose] public section\n\n" ++
    "namespace Obend.Hardware.Fabulous\n\n"
  t := t ++ "/-- The configured fabric's logic. -/\n" ++ netLean "mac8Net" N
  t := t ++ s!"\n/-- Flop `k` holds bit `mac8FlopMap[k].2` of register `mac8FlopMap[k].1`. -/\ndef mac8FlopMap : List (Nat × Nat) := {fm}\n"
  t := t ++ "\ntheorem mac8_proj (regs : Nat → BitVec 64) (R0 R1 R2 : BitVec 16)\n" ++
    "    (hr0 : regs 0 = R0.setWidth 64) (hr1 : regs 1 = R1.setWidth 64) (hr2 : regs 2 = R2.setWidth 64) :\n      " ++
    projStmt ++ " :=\n  ⟨" ++ projPrf ++ "⟩\n"
  t := t ++ "\nset_option maxHeartbeats 0 in\n/-- One edge out of reset: the flops' next values are the module's next register bits, and the\noutput pins show `mac_out`. -/\n" ++
    "theorem mac8_step_bv (I0 I1 : BitVec 8) (I2 R0 R1 R2 : BitVec 16) (rst : Bool) (p q v o : Nat → Bool)\n" ++
    "    (s : Nat → BitVec 64)\n    (hp : " ++ hp "rst" ++ ")\n    (hq : " ++ hq ++ ")\n" ++
    "    (hs : s 0 = (mac8Next I0 I1 I2 R0 R1 rst 0).setWidth 64 ∧ s 1 = (mac8Next I0 I1 I2 R0 R1 rst 1).setWidth 64 ∧\n" ++
    "      s 2 = (mac8Next I0 I1 I2 R0 R1 rst 2).setWidth 64)\n    (ho : " ++ ho ++ ")\n    (hv : " ++ hv ++ ") :\n    " ++
    flops ++ " =\n      " ++ exp ++ " ∧\n    " ++ outs ++ " =\n      " ++ outExp ++ " := by\n  " ++
    "simp only [mac8Next] at hs\n  " ++ simpSet ++ " at hp hq hs ho hv ⊢\n  bv_decide (config := { timeout := 1200 })\n\n#assert_compiled mac8_step_bv\n"
  t := t ++ "\nset_option maxHeartbeats 0 in\n/-- A reset edge, from any flop state: every flop's next value is its register's reset bit. -/\n" ++
    "theorem mac8_reset_bv (I0 I1 : BitVec 8) (I2 : BitVec 16) (p q v : Nat → Bool) (s : Nat → BitVec 64)\n" ++
    "    (hp : " ++ hp "true" ++ ")\n    (hs : s 0 = 0#64 ∧ s 1 = 0#64 ∧ s 2 = 0#64)\n    (hv : " ++ hv ++ ") :\n    " ++
    flops ++ " =\n      " ++ exp ++ " := by\n  simp only [lut4, mux2, List.cons.injEq, and_true] at hp hs hv ⊢\n  bv_decide (config := { timeout := 1200 })\n\n#assert_compiled mac8_reset_bv\n"
  t := t ++ "\nend Obend.Hardware.Fabulous\n"
  return t

/-- Load a FABulous project's metadata (`DIR/.FABulous/{bitStreamSpec.csv, pips.txt, bel.v2.txt}`). -/
def loadProject (dir : String) : IO Fabric := do
  let rd (f : String) := IO.FS.readFile s!"{dir}/.FABulous/{f}"
  IO.ofExcept (loadFabric (← rd "bitStreamSpec.csv") (← rd "pips.txt") (← rd "bel.v2.txt"))

/-- Decode and extract a bitstream against a project's metadata. -/
def readBack (fab : Fabric) (bin : ByteArray) : Except String (Net × Std.HashMap (String × Nat) Bool) := do
  let cfg ← decodeBin fab.cols fab.rows bin
  extract fab cfg mac8Pins

/-- The correspondence `flopCandidates` finds on 400 seeded cycles, or the flops it leaves ambiguous. -/
def mac8FlopMapOf (N : Net) : Except String (List (Nat × Nat)) :=
  let cands := flopCandidates N iceStickMac8 mac8Pins (seededCycles iceStickMac8 400)
  (cands.toList.zipIdx).mapM fun (c, k) => match c with
    | [rj] => .ok rj
    | [] => .error s!"flop {k} ({(N.flops[k]?.map (·.site)).getD "?"}) tracks no register bit of iceStickMac8"
    | _ => .error s!"flop {k} ({(N.flops[k]?.map (·.site)).getD "?"}) tracks several register bits: {c}"

end Obend.Hardware.Fabulous
