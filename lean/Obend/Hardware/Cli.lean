module
/-
# Obend.Hardware.Cli — `obend hardware`, `obend fabublox`, and `obend verify` Hardware Receipt Support

Provides CLI commands for hardware synthesis, Leiserson–Saxe retiming, physical Place-and-Route
(PnR) + FABulous bitstream verification, FabuBlox cleanroom recipe verification, and `wafer.space`
(`GF180MCU` / `Sky130` / `IHP SG13G2`) MPW shuttle signoff:

    obend hardware verify-pnr [--mode valid|collision|short] [--out RECEIPT.json]
        check a physical Place-and-Route + bitstream certificate by `hw-pnr-bitstream@1`;
        writes a receipt re-checkable by `obend verify RECEIPT.json`.
    obend hardware verify-retime [--lag1 N] [--out RECEIPT.json]
        check a Leiserson–Saxe integer lag certificate by `hw-retime-sta@1`.
    obend hardware waferspace-signoff [--mode golden|bad_antenna|bad_cmp] [--out RECEIPT.json]
        check a `wafer.space` GF180MCU MPW shuttle signoff certificate by `waferspace-signoff@1`.
    obend fabublox check [--recipe damascene|post_cu_anneal|under_etch] [--out RECEIPT.json]
        check a FabuBlox cleanroom nanofabrication recipe by `fabublox-run@1`.
    obend fabric (check|extract|flip|vectors|wrapper) --project DIR --bin FILE ...
        read a FABulous bitstream back to the logic it configures (`Obend.Hardware.Fabulous.Cli`).
    obend verify RECEIPT.json
        re-checks any `"kind": "hardware"` receipt through its registered `Obend.Hardware.Judge` format.
    obend hardware emit-sv --top <module> [--out FILE.sv]
    obend hardware emit-silicon-sv [--out FILE.sv]
        emit SystemVerilog from a Lean `RtlModule` / the `SiliconElabFabric` emitter (the checked-in
        `.sv` files are regenerated by these and compared byte-for-byte by the verify scripts).

Status (2026-11-04): the PnR, retiming, FabuBlox, DRC, TCAD and wafer.space judges check certificates
that are models and worked examples (`reference*` records in their modules), not extractions from a
layout of any design in this tree; `obend tapeout` therefore writes no signoff receipt. They stay as
documentation of the checks a real flow would owe until a bitstream exists.
-/
public import Lean.Data.Json
public import Obend.Hardware.Judge
public import Obend.Hardware.TapeoutPipeline
public import Obend.Hardware.VerilateRunner
public import Obend.Lower.SiliconElabFabric
public import Obend.Hardware.Fabulous.Cli
public section

namespace Obend.Hardware.Cli
open Lean (Json toJson)
open Obend.Judge
open Obend.Hardware.Judge

/-- Construct a JSON hardware receipt for `formatName` (`e.g. "hw-pnr-bitstream@1"`). -/
def mkHwReceiptJson (formatName : String) (objJson certJson : Json) : Json :=
  Json.mkObj
    [ ("kind",        toJson "hardware")
    , ("format",      toJson formatName)
    , ("object",      objJson)
    , ("certificate", certJson) ]

/-- Verify a decoded `"kind": "hardware"` JSON receipt using the registered `Obend.Hardware.Judge` format. -/
def verifyHardware (j : Json) : IO UInt32 := do
  let fmtTag := (j.getObjValAs? String "format").toOption.getD ""
  let objStr := ((j.getObjVal? "object").toOption.getD Json.null).compress
  let certStr := ((j.getObjVal? "certificate").toOption.getD Json.null).compress
  match findHardwareFormat? fmtTag with
  | none =>
    IO.eprintln s!"refused: unknown hardware format {fmtTag}"
    return 3
  | some fmt =>
    match fmt.checkBytes 0 objStr certStr with
    | .ok =>
      IO.println s!"verified ({fmtTag}, decidable, kernel)"
      return 0
    | .refused (.malformed m) _ =>
      IO.eprintln s!"refused: malformed {m}"
      return 3
    | .refused (.judge _) _ =>
      IO.eprintln s!"refused: certificate rejected by {fmtTag}"
      return 3
    | .uncovered =>
      IO.eprintln "uncovered"
      return 3

/-- Intercept `obend verify PATH` when `PATH` is a `"kind": "hardware"` receipt; otherwise delegate. -/
def verifyOr (path : String) (otherwise : IO UInt32) : IO UInt32 := do
  let j? := Json.parse (← IO.FS.readFile path)
  match j? with
  | .ok j =>
    if (j.getObjValAs? String "kind").toOption == some "hardware" then
      verifyHardware j
    else
      otherwise
  | .error _ => otherwise

/-- Extract `--flag VALUE` from a CLI argument list. -/
def extractFlag (flagName : String) : List String → Option String × List String
  | [] => (none, [])
  | f :: v :: rest =>
    if f == flagName then
      (some v, rest)
    else
      let (found, rem) := extractFlag flagName (v :: rest)
      (found, f :: rem)
  | [single] => (none, [single])

/-- Run `hw-pnr-bitstream@1` CLI check and optionally emit a receipt. -/
def cmdVerifyPnr (args : List String) : IO UInt32 := do
  let (modeOpt, args1) := extractFlag "--mode" args
  let (outOpt, _)      := extractFlag "--out" args1
  let mode := modeOpt.getD "valid"
  let cell1TileY : Nat := if mode == "collision" then 0 else 1
  let net1Dst    : Nat := if mode == "short" then 11 else 21
  let objJson  := Json.mkObj [("periodPs", toJson (2000 : Nat))]
  let certJson := Json.mkObj
    [ ("designName",   toJson "obend_routed_adder2")
    , ("sinkCapFf",    toJson (5 : Nat))
    , ("cell1TileY",   toJson cell1TileY)
    , ("cell0BelSlot", toJson (0 : Nat))
    , ("cell1BelSlot", toJson (0 : Nat))
    , ("net0DstWire",  toJson (12 : Nat))
    , ("net1DstWire",  toJson net1Dst) ]
  let recJson  := mkHwReceiptJson "hw-pnr-bitstream@1" objJson certJson
  if let some outPath := outOpt then
    IO.FS.writeFile outPath (recJson.pretty ++ "\n")
    IO.println s!"wrote {outPath}"
  verifyHardware recJson

/-- Run `hw-retime-sta@1` CLI check and optionally emit a receipt. -/
def cmdVerifyRetime (args : List String) : IO UInt32 := do
  let (lagOpt, args1) := extractFlag "--lag1" args
  let (outOpt, _)     := extractFlag "--out" args1
  let lag1 : Int := match lagOpt.bind String.toInt? with
    | some k => k
    | none   => 1
  let objJson  := Json.mkObj [("periodPs", toJson (2000 : Nat))]
  let certJson := Json.mkObj
    [ ("lag0",           toJson (0 : Int))
    , ("lag1",           toJson lag1)
    , ("ioLatencyShift", toJson (0 : Int)) ]
  let recJson  := mkHwReceiptJson "hw-retime-sta@1" objJson certJson
  if let some outPath := outOpt then
    IO.FS.writeFile outPath (recJson.pretty ++ "\n")
    IO.println s!"wrote {outPath}"
  verifyHardware recJson

/-- Run `datasheet-fit@1` CLI check and optionally emit a receipt. -/
def cmdDatasheetCheck (args : List String) : IO UInt32 := do
  let (modeOpt, args1) := extractFlag "--mode" args
  let (outOpt, _)      := extractFlag "--out" args1
  let mode := modeOpt.getD "calibrated"
  let rcvVih : Int := if mode == "74ls_to_74hc_direct" then 3500 else 2000
  let rcvVil : Int := if mode == "74ls_to_74hc_direct" then 1500 else 800
  let maxErr : Int := if mode == "uncalibrated_drift" then 5 else 25
  let objJson  := Json.mkObj [("suite", toJson "obend_74ls_hct_ina_calibrated")]
  let certJson := Json.mkObj
    [ ("suiteName",     toJson "obend_74ls_hct_ina_calibrated")
    , ("pullupBoostMv", toJson (0 : Int))
    , ("minMarginMv",   toJson (400 : Int))
    , ("rcvVihMinMv",   toJson rcvVih)
    , ("rcvVilMaxMv",   toJson rcvVil)
    , ("fanout",        toJson (8 : Nat))
    , ("maxCalErrMv",   toJson maxErr)
    , ("buckLoadMa",    toJson (2000 : Nat)) ]
  let recJson  := mkHwReceiptJson "datasheet-fit@1" objJson certJson
  if let some outPath := outOpt then
    IO.FS.writeFile outPath (recJson.pretty ++ "\n")
    IO.println s!"wrote {outPath}"
  verifyHardware recJson

/-- Run `agentic-eda-swap@1` CLI check and optionally emit a receipt. -/
def cmdEdaVaultCheck (args : List String) : IO UInt32 := do
  let (modeOpt, args1) := extractFlag "--mode" args
  let (outOpt, _)      := extractFlag "--out" args1
  let mode := modeOpt.getD "golden"
  let cost : Nat := if mode == "overbudget" then 320 else 120
  let objJson  := Json.mkObj [("minMarginMv", toJson (400 : Int))]
  let certJson := Json.mkObj
    [ ("pageName",    toJson "U4_LDO")
    , ("vohMinMv",    toJson (2950 : Nat))
    , ("vihMinMv",    toJson (2000 : Nat))
    , ("volMaxMv",    toJson (180 : Nat))
    , ("vilMaxMv",    toJson (800 : Nat))
    , ("pkgWidthUm",  toJson (3000 : Nat))
    , ("pkgLengthUm", toJson (3000 : Nat))
    , ("pinCount",    toJson (16 : Nat))
    , ("pinPitchUm",  toJson (500 : Nat))
    , ("maxTempMc",   toJson (68000 : Nat))
    , ("vswrMilli",   toJson (1280 : Nat))
    , ("drcErrors",   toJson (0 : Nat))
    , ("costCents",   toJson cost) ]
  let recJson  := mkHwReceiptJson "agentic-eda-swap@1" objJson certJson
  if let some outPath := outOpt then
    IO.FS.writeFile outPath (recJson.pretty ++ "\n")
    IO.println s!"wrote {outPath}"
  verifyHardware recJson

/-- Run `hw-binary-cbor@1` / `hw-binary-tape-cbor@1` binary CBOR certificate encode/decode/verify and `.obnb` projection (NO JSON). -/
def cmdVerifyCbor (args : List String) : IO UInt32 := do
  let (domOpt, args1)  := extractFlag "--domain" args
  let (modeOpt, args2) := extractFlag "--mode" args1
  let (binInOpt, args3) := extractFlag "--in-bin" args2
  let (binOutOpt, args4) := extractFlag "--out-bin" args3
  let (obnbOutOpt, _)  := extractFlag "--out-obnb" args4
  let domName := domOpt.getD "pnr"
  let mode := modeOpt.getD "golden"
  let expectedDom : Obend.Hardware.Codec.HwCertDomain :=
    if domName == "photonics" then .photonics
    else if domName == "pcb" then .pcb
    else if domName == "dpr" then .dpr
    else if domName == "eda" then .edaBomSwap
    else if domName == "magnetics" || domName == "femm" then .magnetics
    else .pnr
  let baseCert : Obend.Hardware.Codec.BinaryHwCert :=
    match expectedDom with
    | .photonics => Obend.Hardware.Codec.goldenBinaryPhotonicsCert
    | .pcb => Obend.Hardware.Codec.goldenBinaryPcbCert
    | .dpr => Obend.Hardware.Codec.goldenBinaryDprCert
    | .edaBomSwap => Obend.Hardware.Codec.goldenBinaryEdaSwapCert
    | .magnetics => Obend.Hardware.Codec.goldenBinaryMagneticsCert
    | _ =>
      if mode == "corrupt" then badBinaryPnrCert
      else Obend.Hardware.Codec.goldenBinaryPnrCert
  let defaultBytes : ByteArray :=
    if mode == "tape" then
      Obend.Hardware.Codec.encodeToByteArray Obend.Hardware.Codec.goldenBinaryFemmTapeCert
    else
      Obend.Hardware.Codec.encodeToByteArray baseCert
  let rawBytes : ByteArray ← match binInOpt with
    | some inPath => IO.FS.readBinFile inPath
    | none => pure defaultBytes
  if let some outBinPath := binOutOpt then
    IO.FS.writeBinFile outBinPath rawBytes
    IO.println s!"wrote binary CBOR ({rawBytes.size} bytes) to {outBinPath}"
  if let some obnbPath := obnbOutOpt then
    let obnbBytes := Obend.Hardware.Codec.obendHwCborProjectCell rawBytes
    IO.FS.writeBinFile obnbPath obnbBytes
    IO.println s!"wrote binary .obnb Core.Data cell ({obnbBytes.size} bytes) to {obnbPath}"
  match verifyRawBinaryCborCert expectedDom rawBytes with
  | .ok =>
    IO.println s!"verified (hw-binary-cbor@1, domain={domName}, bytes={rawBytes.size}, decidable, kernel)"
    return 0
  | .refused _ _ =>
    IO.eprintln s!"refused: binary CBOR certificate rejected by hw-binary-cbor@1 (domain={domName})"
    return 3
  | .uncovered =>
    IO.eprintln s!"uncovered: binary CBOR certificate obligations uncovered (domain={domName})"
    return 3

/-- Compile a userspace `.obend` physical engineering `Composition` via `compileCompositionToVerifiedRtl`
    and emit synthesizable SystemVerilog-2012 via `emitModuleSV`. -/
def cmdEmitSv (args : List String) : IO UInt32 :=
  Obend.Hardware.VerilateRunner.cmdEmitSv args

/-- `obend hardware emit-silicon-sv [--out FILE.sv]`: write the one `silicon_elab_top.sv`, the text of
`Obend.Lower.SiliconElabFabric.emitSiliconElabFabricSV` behind a two-line provenance header. The
checked-in copy under `apps/silicon-kernel-verilator/verilator/` is regenerated by this command and
compared byte-for-byte by `verify_silicon_kernel.sh`; it is not edited by hand. -/
def siliconElabTopSvText : String :=
  "// Generated by Obend.Lower.SiliconElabFabric.emitSiliconElabFabricSV (obend hardware emit-silicon-sv).\n" ++
  "// Do not edit: regenerate from the Lean definition; the verify script compares bytes.\n" ++
  Obend.Lower.SiliconElabFabric.emitSiliconElabFabricSV ++ "\n"

def cmdEmitSiliconSv (args : List String) : IO UInt32 := do
  let (outOpt, _) := extractFlag "--out" args
  match outOpt with
  | some outPath =>
    IO.FS.writeFile outPath siliconElabTopSvText
    IO.println s!"wrote silicon_elab_top.sv ({siliconElabTopSvText.length} bytes) to {outPath}"
    return 0
  | none =>
    IO.print siliconElabTopSvText
    return 0

/-- Run `obend verilate <input.obend> [--top <name>] [--vectors N] [--cycles C] [--vcd <out.vcd>]`. -/
def cmdVerilate (args : List String) : IO UInt32 :=
  Obend.Hardware.VerilateRunner.cmdVerilate args

/-- Extract a module name stem from a file path (e.g., `"stdlib/physical/CleanroomTcadStack.obend"` -> `"CleanroomTcadStack"`). -/
def moduleStemOfPath (p : String) : String :=
  let base := match (p.splitOn "/").getLast? with
    | some b => b
    | none   => p
  if base.endsWith ".obend" then
    (base.take (base.length - 6)).toString
  else
    base

/-- Run the end-to-end 9-stage `.obend` silicon tapeout pipeline (`obend tapeout <FILE.obend>`):
1. Front-end parse, Isar `contract` proof-script + judge-tag verification, C4 lowering & `FrontEnd.accept`,
2. `Obend.Leaf.emit` + `specializeBookDict` (`betaRecordDict ∘ inlineDict`),
3. Multi-stage pipelined / sequential RTL compilation + `checkRtlModule`,
4. `Synth.synthesizeModuleToBels` + `checkBelNetlistValid`,
5. Leiserson–Saxe `solveVerifiedRetiming?` + `checkRetimingCert`,
6. `PlaceRoute` (`decoupleRightBranchWithBuffer` + `checkPnrCertificate`),
7. 1D/2D `DRC` + `FabuBlox.runFabFlow` + `TcadBridge.extractTcadCornerEnvelope` `[FF, TT, SS]` dual-corner signoff,
8. `WaferSpace.checkWaferSpaceSignoff`,
9. SystemVerilog (`emitModuleSV`), LibreLane JSON (`emitLibreLaneGf180Json`), and dated `Receipt`. -/
def cmdTapeout (args : List String) : IO UInt32 := do
  let (entryOpt, args1)   := extractFlag "--entry" args
  let (modeOpt, args2)    := extractFlag "--mode" args1
  let (svOutOpt, args3)   := extractFlag "--out-sv" args2
  let (_llOutOpt, args4)  := extractFlag "--out-librelane" args3
  let (recOutOpt, args5)  := extractFlag "--out-receipt" args4
  let posArgs := args5.filter (fun a => !a.startsWith "--")
  let useGolden := args5.contains "--golden" || posArgs.isEmpty
  let compileMode : Obend.Hardware.TapeoutPipeline.RtlCompileMode :=
    match modeOpt with
    | some "seq"  => .sequentialSat
    | some "comb" => .combinationalSat
    | _           => .pipelined
  let res : Except Obend.Hardware.TapeoutPipeline.TapeoutError Obend.Hardware.TapeoutPipeline.SiliconTapeoutArtifact ←
    if useGolden then
      let cfg : Obend.Hardware.TapeoutPipeline.TapeoutConfig :=
        { Obend.Hardware.TapeoutPipeline.referenceTapeoutConfig with
          entryDef    := entryOpt.getD Obend.Hardware.TapeoutPipeline.referenceTapeoutConfig.entryDef
          compileMode := compileMode }
      match Obend.Hardware.TapeoutPipeline.compileObendModuleToSiliconTapeout cfg
          Obend.Hardware.TapeoutPipeline.referenceTapeoutObendSource with
      | .ok art => pure (.ok art)
      | .error _ =>
        pure (Obend.Hardware.TapeoutPipeline.compileCompositionToSiliconTapeout
          cfg
          Obend.Hardware.TapeoutPipeline.referenceCleanroomTcadComp
          [Obend.Hardware.TapeoutPipeline.referenceTapeoutIsarCert])
    else
      let filePath := posArgs.headD "CleanroomTcadStack.obend"
      let src ← IO.FS.readFile filePath
      let modName := moduleStemOfPath filePath
      let cfg : Obend.Hardware.TapeoutPipeline.TapeoutConfig :=
        { Obend.Hardware.TapeoutPipeline.referenceTapeoutConfig with
          moduleName  := modName
          entryDef    := entryOpt.getD ""
          compileMode := compileMode }
      pure (Obend.Hardware.TapeoutPipeline.compileObendModuleToSiliconTapeout cfg src)
  match res with
  | .error err =>
    IO.eprintln s!"refused (tapeout): {reprStr err}"
    return 3
  | .ok art =>
    if let some svPath := svOutOpt then
      IO.FS.writeFile svPath art.systemVerilog
      IO.println s!"wrote SystemVerilog ({art.rtlModule.wires.length} wires, {art.rtlModule.regs.length} regs) to {svPath}"
    if let some recPath := recOutOpt then
      IO.eprintln s!"refused: no standalone JSON receipt is written to {recPath}; use `art.receipt` (cSHAKE256 SV byte digest) or `--out-sv`."
      return 3
    IO.println s!"verified tapeout ({art.moduleName}): slots={art.specializedBook.slots.length}, wires={art.rtlModule.wires.length}, regs={art.rtlModule.regs.length}, bels={art.belNetlist.cells.length}, corner=[FF:{art.tcadEnvelope.fastCorner.tGateMaxPs}ps, TT:{art.tcadEnvelope.nomCorner.tGateMaxPs}ps, SS:{art.tcadEnvelope.slowCorner.tGateMaxPs}ps], verdict=ok"
    return 0

/-- CLI entry point for `obend verilate ...`, `obend tapeout ...`, `obend hardware ...`, and `obend fabric ...`. -/
public def main? : List String → Option (IO UInt32)
  | "verilate" :: rest                       => some (cmdVerilate rest)
  | "hardware" :: "verilate" :: rest         => some (cmdVerilate rest)
  | "hardware" :: "emit-silicon-sv" :: rest  => some (cmdEmitSiliconSv rest)
  | "tapeout" :: rest                        => some (cmdTapeout rest)
  | "hardware" :: "tapeout" :: rest          => some (cmdTapeout rest)
  | "hardware" :: "verify-pnr" :: rest       => some (cmdVerifyPnr rest)
  | "hardware" :: "verify-retime" :: rest    => some (cmdVerifyRetime rest)
  | "hardware" :: "datasheet-check" :: rest  => some (cmdDatasheetCheck rest)
  | "hardware" :: "eda-vault-check" :: rest  => some (cmdEdaVaultCheck rest)
  | "hardware" :: "verify-cbor" :: rest      => some (cmdVerifyCbor rest)
  | "hardware" :: "verify-tape-cbor" :: rest => some (cmdVerifyCbor ("--mode" :: "tape" :: rest))
  | "hardware" :: "emit-sv" :: rest          => some (cmdEmitSv rest)
  | "fabric" :: rest                         => some (Obend.Hardware.Fabulous.cmdFabric rest)
  | _ => none

end Obend.Hardware.Cli
