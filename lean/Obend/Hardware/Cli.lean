/-- Run `hw-binary-cbor@1` / `hw-binary-tape-cbor@1` binary CBOR certificate encode/decode/verify and `.obnb` projection (NO JSON). -/
def cmdVerifyCbor (args : List String) : IO UInt32 := do
  let (domOpt, args1)  := extractFlag "--domain" args
  let (modeOpt, args2) := extractFlag "--mode" args1
  let (binInOpt, args3) := extractFlag "--in-bin" args2
  let (binOutOpt, args4) := extractFlag "--out-bin" args3
  let (obnbOutOpt, _)  := extractFlag "--out-obnb" args4
  let domName := domOpt.getD "pnr"
  let mode := modeOpt.getD "golden"
  let expectedDom : Obend.Hardware.Codec.HwCertDomain :=
    if domName == "photonics" then .photonics
    else if domName == "dpr" then .dpr
    else if domName == "eda" then .edaBomSwap
    else if domName == "magnetics" || domName == "femm" then .magnetics
    else if domName == "fluid" || domName == "cooling" then .fluidThermal
    else if domName == "power" || domName == "ms350" then .powerElectronics
    else if domName == "mechanics" || domName == "von_neumann" then .mechanicsVonNeumann
    else .pnr
  let baseCert : Obend.Hardware.Codec.BinaryHwCert :=
    match expectedDom with
    | .photonics => Obend.Hardware.Codec.goldenBinaryPhotonicsCert
    | .dpr => Obend.Hardware.Codec.goldenBinaryDprCert
    | .edaBomSwap => Obend.Hardware.Codec.goldenBinaryEdaSwapCert
    | .magnetics => Obend.Hardware.Codec.goldenBinaryMagneticsCert
    | .fluidThermal => Obend.Hardware.Codec.goldenBinaryFluidThermalCert
    | .powerElectronics => Obend.Hardware.Codec.goldenBinaryPowerElectronicsCert
    | .mechanicsVonNeumann => Obend.Hardware.Codec.goldenBinaryMechanicsCert
    | _ =>
      if mode == "corrupt" then badBinaryPnrCert
      else Obend.Hardware.Codec.goldenBinaryPnrCert
  let defaultBytes : ByteArray :=
    if mode == "tape" then
      let tapeCert := match expectedDom with
        | .mechanicsVonNeumann => Obend.Hardware.Codec.goldenBinaryOctreeTapeCert
        | .fluidThermal => Obend.Hardware.Codec.goldenBinaryEvolutionTapeCert
        | _ => Obend.Hardware.Codec.goldenBinaryFemmTapeCert
      Obend.Hardware.Codec.encodeToByteArray tapeCert
    else
      Obend.Hardware.Codec.encodeToByteArray baseCert
  let rawBytes : ByteArray ← match binInOpt with
    | some inPath => IO.FS.readBinFile inPath
    | none => pure defaultBytes
  if let some outBinPath := binOutOpt then
    IO.FS.writeBinFile outBinPath rawBytes
    IO.println s!"wrote binary CBOR ({rawBytes.size} bytes) to {outBinPath}"
  if let some obnbPath := obnbOutOpt then
    let obnbBytes := Obend.Hardware.Codec.obendHwCborProjectCell rawBytes
    IO.FS.writeBinFile obnbPath obnbBytes
    IO.println s!"wrote binary .obnb Core.Data cell ({obnbBytes.size} bytes) to {obnbPath}"
  match verifyRawBinaryCborCert expectedDom rawBytes with
  | .ok =>
    IO.println s!"verified (hw-binary-cbor@1, domain={domName}, bytes={rawBytes.size}, decidable, kernel)"
    return 0
  | .refused _ _ =>
    IO.eprintln s!"refused: binary CBOR certificate rejected by hw-binary-cbor@1 (domain={domName})"
    return 3
  | .uncovered =>
    IO.eprintln s!"uncovered: binary CBOR certificate obligations uncovered (domain={domName})"
    return 3

/-- Compile a userspace `.obend` physical engineering `Composition` via `compileCompositionToVerifiedRtl`
    and emit synthesizable SystemVerilog-2012 via `emitModuleSV`. -/
def cmdEmitSv (args : List String) : IO UInt32 :=
  Obend.Hardware.VerilateRunner.cmdEmitSv args

/-- `obend hardware emit-silicon-sv [--out FILE.sv]`: write the one `silicon_elab_top.sv`, the text of
`Obend.Lower.SiliconElabFabric.emitSiliconElabFabricSV` behind a two-line provenance header. The
checked-in copy under `apps/silicon-kernel-verilator/verilator/` is regenerated by this command and
compared byte-for-byte by `verify_silicon_kernel.sh`; it is not edited by hand. -/
def siliconElabTopSvText : String :=
  "// Generated by Obend.Lower.SiliconElabFabric.emitSiliconElabFabricSV (obend hardware emit-silicon-sv).\n" ++
  "// Do not edit: regenerate from the Lean definition; the verify script compares bytes.\n" ++
  Obend.Lower.SiliconElabFabric.emitSiliconElabFabricSV ++ "\n"

def cmdEmitSiliconSv (args : List String) : IO UInt32 := do
  let (outOpt, _) := extractFlag "--out" args
  match outOpt with
  | some outPath =>
    IO.FS.writeFile outPath siliconElabTopSvText
    IO.println s!"wrote silicon_elab_top.sv ({siliconElabTopSvText.length} bytes) to {outPath}"
    return 0
  | none =>
    IO.print siliconElabTopSvText
    return 0

/-- Run `obend verilate <input.obend> [--top <name>] [--vectors N] [--cycles C] [--vcd <out.vcd>]`. -/
def cmdVerilate (args : List String) : IO UInt32 :=
  Obend.Hardware.VerilateRunner.cmdVerilate args

/-- Extract a module name stem from a file path (e.g., `"stdlib/physical/CleanroomTcadStack.obend"` -> `"CleanroomTcadStack"`). -/
def moduleStemOfPath (p : String) : String :=
  let base := match (p.splitOn "/").getLast? with
    | some b => b
    | none   => p
  if base.endsWith ".obend" then
    (base.take (base.length - 6)).toString
  else
    base

/-- Run the end-to-end 9-stage `.obend` silicon tapeout pipeline (`obend tapeout <FILE.obend>`):
1. Front-end parse, Isar `contract` proof-script + judge-tag verification, C4 lowering & `FrontEnd.accept`,
2. `Obend.Leaf.emit` + `specializeBookDict` (`betaRecordDict ∘ inlineDict`),
3. Multi-stage pipelined / sequential RTL compilation + `checkRtlModule`,
4. `Synth.synthesizeModuleToBels` + `checkBelNetlistValid`,
5. Leiserson–Saxe `solveVerifiedRetiming?` + `checkRetimingCert`,
6. `PlaceRoute` (`decoupleRightBranchWithBuffer` + `checkPnrCertificate`),
7. 1D/2D `DRC` + `FabuBlox.runFabFlow` + `TcadBridge.extractTcadCornerEnvelope` `[FF, TT, SS]` dual-corner signoff,
8. `WaferSpace.checkWaferSpaceSignoff`,
9. SystemVerilog (`emitModuleSV`), LibreLane JSON (`emitLibreLaneGf180Json`), and dated `Receipt`. -/
def cmdTapeout (args : List String) : IO UInt32 := do
  let (entryOpt, args1)   := extractFlag "--entry" args
  let (modeOpt, args2)    := extractFlag "--mode" args1
  let (svOutOpt, args3)   := extractFlag "--out-sv" args2
  let (llOutOpt, args4)   := extractFlag "--out-librelane" args3
  let (recOutOpt, args5)  := extractFlag "--out-receipt" args4
  let posArgs := args5.filter (fun a => !a.startsWith "--")
  let useGolden := args5.contains "--golden" || posArgs.isEmpty
  let compileMode : Obend.Hardware.TapeoutPipeline.RtlCompileMode :=
    match modeOpt with
    | some "seq"  => .sequentialSat
    | some "comb" => .combinationalSat
    | _           => .pipelined
  let res : Except Obend.Hardware.TapeoutPipeline.TapeoutError Obend.Hardware.TapeoutPipeline.SiliconTapeoutArtifact ←
    if useGolden then
      let cfg : Obend.Hardware.TapeoutPipeline.TapeoutConfig :=
        { Obend.Hardware.TapeoutPipeline.goldenTapeoutConfig with
          entryDef    := entryOpt.getD Obend.Hardware.TapeoutPipeline.goldenTapeoutConfig.entryDef
          compileMode := compileMode }
      match Obend.Hardware.TapeoutPipeline.compileObendModuleToSiliconTapeout cfg
          Obend.Hardware.TapeoutPipeline.goldenTapeoutObendSource with
      | .ok art => pure (.ok art)
      | .error _ =>
        pure (Obend.Hardware.TapeoutPipeline.compileCompositionToSiliconTapeout
          cfg
          Obend.Hardware.TapeoutPipeline.goldenCleanroomTcadComp
          [Obend.Hardware.TapeoutPipeline.goldenTapeoutIsarCert])
    else
      let filePath := posArgs.headD "CleanroomTcadStack.obend"
      let src ← IO.FS.readFile filePath
      let modName := moduleStemOfPath filePath
      let cfg : Obend.Hardware.TapeoutPipeline.TapeoutConfig :=
        { Obend.Hardware.TapeoutPipeline.goldenTapeoutConfig with
          moduleName  := modName
          entryDef    := entryOpt.getD ""
          compileMode := compileMode }
      pure (Obend.Hardware.TapeoutPipeline.compileObendModuleToSiliconTapeout cfg src)
  match res with
  | .error err =>
    IO.eprintln s!"refused (tapeout): {reprStr err}"
    return 3
  | .ok art =>
    if let some svPath := svOutOpt then
      IO.FS.writeFile svPath art.systemVerilog
      IO.println s!"wrote SystemVerilog ({art.rtlModule.wires.length} wires, {art.rtlModule.regs.length} regs) to {svPath}"
    if let some llPath := llOutOpt then
      IO.FS.writeFile llPath (art.libreLaneJson ++ "\n")
      IO.println s!"wrote LibreLane GF180MCU config to {llPath}"
    if let some recPath := recOutOpt then
      IO.eprintln s!"refused: no tapeout receipt is written to {recPath}; the DRC, FabuBlox, TCAD and wafer.space stages check model certificates from `TapeoutConfig` defaults, not a layout of this design (QUALIFICATION-AND-SILICON-LEAN.md §3). The SystemVerilog and LibreLane outputs stand on their own."
      return 3
    IO.println s!"verified tapeout ({art.moduleName}): slots={art.specializedBook.slots.length}, wires={art.rtlModule.wires.length}, regs={art.rtlModule.regs.length}, bels={art.belNetlist.cells.length}, tcad=[FF:{art.tcadEnvelope.fastCorner.tGateMaxPs}ps, TT:{art.tcadEnvelope.nomCorner.tGateMaxPs}ps, SS:{art.tcadEnvelope.slowCorner.tGateMaxPs}ps], verdict=ok"
    return 0

/-- CLI entry point for `obend verilate ...`, `obend tapeout ...`, `obend hardware ...`, and `obend fabublox ...`. -/
public def main? : List String → Option (IO UInt32)
  | "verilate" :: rest                         => some (cmdVerilate rest)
  | "hardware" :: "verilate" :: rest           => some (cmdVerilate rest)
  | "hardware" :: "emit-silicon-sv" :: rest    => some (cmdEmitSiliconSv rest)
  | "tapeout" :: rest                          => some (cmdTapeout rest)
  | "hardware" :: "tapeout" :: rest            => some (cmdTapeout rest)
  | "hardware" :: "verify-pnr" :: rest         => some (cmdVerifyPnr rest)
  | "hardware" :: "verify-retime" :: rest      => some (cmdVerifyRetime rest)
  | "hardware" :: "waferspace-signoff" :: rest => some (cmdWaferSpaceSignoff rest)
  | "hardware" :: "datasheet-check" :: rest    => some (cmdDatasheetCheck rest)
  | "hardware" :: "rf-signoff" :: rest         => some (cmdRfSignoff rest)
  | "hardware" :: "photonics-signoff" :: rest  => some (cmdPhotonicsSignoff rest)
  | "hardware" :: "pcb-signoff" :: rest        => some (cmdPcbSignoff rest)
  | "hardware" :: "eda-vault-check" :: rest    => some (cmdEdaVaultCheck rest)
  | "hardware" :: "verify-cbor" :: rest        => some (cmdVerifyCbor rest)
  | "hardware" :: "verify-tape-cbor" :: rest   => some (cmdVerifyCbor ("--mode" :: "tape" :: rest))
  | "hardware" :: "emit-sv" :: rest            => some (cmdEmitSv rest)
  | "fabublox" :: "check" :: rest              => some (cmdFabuBloxCheck rest)
  | _ => none

end Obend.Hardware.Cli
