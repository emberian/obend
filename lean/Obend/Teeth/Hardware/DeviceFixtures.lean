/-- Bytes in, verdict out, as the format runs it. -/
def verdictOf (spec cert : String) : Option (Verdict DdClause) :=
  match decodeDdSpec spec, decodeDdSolution cert with
  | .ok o, .ok c => some (checkDd o c)
  | _, _ => none

private theorem verdictOf_decoded (spec cert : String) (o : DdSpec) (c : DdSolution)
    (hs : decodeDdSpec spec = .ok o) (hc : decodeDdSolution cert = .ok c) :
    verdictOf spec cert = some (checkDd o c) := by
  unfold verdictOf
  rw [hs, hc]

private theorem verdictOf_test (spec cert : String) (o : DdSpec) (c : DdSolution)
    (p : Verdict DdClause → Bool) (hs : decodeDdSpec spec = .ok o) (hc : decodeDdSolution cert = .ok c)
    (h : p (checkDd o c) = true) : (verdictOf spec cert).map p = some true := by
  rw [verdictOf_decoded spec cert o c hs hc]
  exact congrArg some h

/-- The object's recipe is the Lean-stated one. -/
def recipeIs (spec : String) (r : List ProcessStep) : Bool :=
  match decodeDdSpec spec with
  | .ok o => decide (o.recipe = r)
  | .error _ => false

