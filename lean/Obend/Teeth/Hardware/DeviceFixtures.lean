private theorem firstFailing_of_all (m : Nat) (f : Nat → Bool)
    (h : ∀ i < m, f i = true) : firstFailing m f = none := by
  unfold firstFailing
  apply List.find?_eq_none.2
  intro i hi
  simp [h i (List.mem_range.1 hi)]
private theorem firstFailing_range_append (f : Nat → Bool) (lo a b : Nat)
    (ha : firstFailing a (fun i => f (lo+i)) = none)
    (hb : firstFailing b (fun i => f (lo+a+i)) = none) :
    firstFailing (a+b) (fun i => f (lo+i)) = none := by
  apply firstFailing_of_all
  intro i hi
  by_cases hia : i < a
  · exact firstFailing_none ha i hia
  · have hb' := firstFailing_none hb (i-a) (by omega)
    have he : lo+a+(i-a) = lo+i := by omega
    simpa only [he] using hb'
private theorem firstFailing_range_zero (f : Nat → Bool) (n : Nat)
    (h : firstFailing n (fun i => f (0+i)) = none) : firstFailing n f = none := by
  simpa only [Nat.zero_add] using h
private theorem firstFailing_and (f g : Nat → Bool) (n : Nat)
    (h : firstFailing n (fun i => f i && g i) = none) :
    firstFailing n f = none ∧ firstFailing n g = none := by
  constructor
  · apply firstFailing_of_all
    intro i hi
    have hi := firstFailing_none h i hi
    simp only [Bool.and_eq_true] at hi
    exact hi.1
  · apply firstFailing_of_all
    intro i hi
    have hi := firstFailing_none h i hi
    simp only [Bool.and_eq_true] at hi
    exact hi.2
private theorem option_getD_checked {α : Type} (x : Option α) (d : α)
    (h : x.isSome = true) : x = some (x.getD d) := by
  cases x with
  | none => cases h
  | some a => rfl
private theorem dd_checked (o : DdSpec) (c : DdSolution) (w : WaferState)
    (env : List (String × Obend.Analysis.Interval))
    (hm : o.meshOk = true) (hl : c.lengthsOk o.nodes = true)
    (hw : runRecipe o.si.kBEv o.dealGroveTol (WaferState.bare o.background) o.recipe c.recipeCert = some w)
    (hd : firstFailing o.nodes (dopingOk o c w) = none) (hi : o.si.niOk c.ni = true)
    (hmu : firstFailing o.nodes (mobilityOk o c) = none) (he : bernEnv? o c = some env)
    (h0 : contactOk o c 0 o.biasV = true) (h1 : contactOk o c (o.nodes-1) 0 = true)
    (hn : firstFailing (o.nodes-2) (fun k => nodeOk o c env (k+1)) = none)
    (hj : currentOk o c env = true) : checkDd o c = .ok := by
  simp only [checkDd, hm, hl, hw, hd, hi, hmu, he, h0, h1, hn, hj,
    Bool.not_true, Bool.false_eq_true, ↓reduceIte]

/-- Recover the original byte decoder result from its kernel-checked normal form. -/
private theorem decoded_eq_ok {α : Type} {e : Except String α} {a : α}
    (h : e.toOption = some a) : e = .ok a := by
  cases e with
  | error _ => cases h
  | ok b => exact congrArg Except.ok (Option.some.inj h)
