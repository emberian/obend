/-- Refused at a contact. -/
def isRefusedContact (i : Nat) : Verdict DdClause → Bool
  | .refused (.contact j) _ => j == i
  | _ => false

-- fixture kept (2026-11-12): the mesh carries the recipe of device A
example : coarseForwardSpec.recipe = sky130DiodeRecipe 1.3e13 := rfl

/-- Device A at equilibrium on the coarse mesh: accepted in the quasi-Fermi form, every clause. -/
theorem coarseEquilibrium_accepted :
    checkDdQuasiFermi coarseEquilibriumSpec coarseEquilibrium = .ok := isOk_eq (by decide +kernel)

/-- Device A at −0.3 V on the coarse mesh: accepted in the quasi-Fermi form, every clause. -/
theorem coarseForward_accepted :
    checkDdQuasiFermi coarseForwardSpec coarseForward = .ok := isOk_eq (by decide +kernel)

-- fixture kept (2026-11-12): the classical checker accepts the same (ψ, n, p) at −0.3 V
example : isOk (checkDd coarseForwardSpec coarseForward.base) = true := by decide +kernel

-- fixture kept (2026-11-12): the −0.3 V certificate on the equilibrium device is refused at the biased contact
example : isRefusedContact 0 (checkDdQuasiFermi coarseEquilibriumSpec coarseForward) = true := by decide +kernel

/-- The −0.3 V certificate with the electron quasi-Fermi potential at node 9 moved by 1 mV. -/
def coarseForwardTampered : DdQuasiFermiSolution :=
  { coarseForward with phiN := coarseForward.phiN.set 9 (coarseForward.phiNAt 9 + 0.001) }

-- fixture kept (2026-11-12): a 1 mV error in one quasi-Fermi potential is refused at that node, as Boltzmann consistency
example : isRefusedBoltzmann 9 (checkDdQuasiFermi coarseForwardSpec coarseForwardTampered) = true := by
  decide +kernel

/-- The `(n, p, ψ)` bound (A) at the first edge, where it is smallest: the contact's own term scale. -/
def classicalBoundAtContact (o : DdSpec) (c : DdSolution) : CanonicalRat :=
  classicalCurrentBound o c ((bernEnv? o c).getD []) 0

/-- The quasi-Fermi bound (A) at the far contact, where it is largest (`qfCurrentBound_mono`). -/
def quasiFermiBoundFar (o : DdSpec) (c : DdQuasiFermiSolution) : CanonicalRat :=
  qfCurrentBound o c ((qfEnv? o c).getD []) (o.nodes - 2)

/-- At −0.3 V: the `(n, p, ψ)` bound is above `10⁻⁹ A` (`10⁻³ A/cm²`, five hundred times the current)
at its smallest, the quasi-Fermi bound is below `10⁻¹⁹ A` (`10⁻¹³ A/cm²`) at its largest. -/
theorem coarseForward_bounds :
    (1.0e-9 : CanonicalRat) < classicalBoundAtContact coarseForwardSpec coarseForward.base ∧
    quasiFermiBoundFar coarseForwardSpec coarseForward < 1.0e-19 := by decide +kernel

/-- At equilibrium the quasi-Fermi bound is the recombination terms' alone: below `10⁻²⁴ A`. -/
theorem coarseEquilibrium_bounds :
    (1.0e-9 : CanonicalRat) < classicalBoundAtContact coarseEquilibriumSpec coarseEquilibrium.base ∧
    quasiFermiBoundFar coarseEquilibriumSpec coarseEquilibrium < 1.0e-24 := by decide +kernel

/-- **The −0.3 V terminal current, certified.** For every table in the enclosures and every edge of
the mesh, the reported current (`−2.09·10⁻¹² A` on `10⁻⁶ cm²`) is within `10⁻¹⁹ A` of the area times
the product-form current on that edge: seven orders below the current, ten below the `(n, p, ψ)` bound. -/
theorem coarseForward_current_certified :
    ∃ env, qfEnv? coarseForwardSpec coarseForward = some env ∧ ∀ rho, BernTable env rho → ∀ e, e + 1 < 23 →
      AbsLe (coarseForward.base.currentA - coarseForwardSpec.areaCm2 * evalExpr rho (jTotQ coarseForwardSpec coarseForward e))
        1.0e-19 := by
  obtain ⟨env, henv, h⟩ := terminal_current_bound_quasiFermi_uniform
    (checkDdQuasiFermi_sound coarseForward_accepted) (by decide +kernel) (by decide +kernel)
  refine ⟨env, henv, fun rho hrho e he => ?_⟩
  have hb := h rho hrho e he
  have hs := coarseForward_bounds.2
  simp only [quasiFermiBoundFar, henv, Option.getD_some] at hs
  unfold AbsLe at hb ⊢
  grind

