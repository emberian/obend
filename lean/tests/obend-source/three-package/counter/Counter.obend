edition ObjectiveBend 1
package commons/counter
# The base: a kind (Tally), a spec over it, an extension, a seed.
record Tally:
  count() -> Nat
  weight() -> Nat

spec Base for Tally:
  def count() -> Nat:
    1n
  combine + weight() -> Nat:
    1n

extension AddOne(self: Nat, super: Nat) -> Nat:
  super + 1n

def blank() -> Tally:
  {count: 0n, weight: 0n}

law bounded: new.total <= 100
