edition ObjectiveBend 1
package kit/pdf extends kit/export@^1
# A more specific exporter: it overrides Cy's implementation for Page.
import papers/report/Report.obend as P
import kit/export/Export.obend as E

protocol E.Export for P.Page:
  def export(self: P.Page) -> Nat:
    self.cited * 1000n + self.sections
