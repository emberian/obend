edition ObjectiveBend 1
package lab/review extends papers/report@^1
# Bo, a stranger to Ada, extends the report kind with a review section, without forking it.
import papers/report/Report.obend as P

spec Reviewed extends P.Report for P.Page:
  combine + sections() -> Nat:
    1n

# A reviewed page keeps at most nine sections.
law reviewed: new.sections <= 9
