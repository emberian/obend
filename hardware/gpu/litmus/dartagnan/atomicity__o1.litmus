VULKAN atomicity
"obend-litmus-check: atomicity, the shape of hardware/gpu/litmus/wgsl/atomicity.wgsl"
{
x=0;
P0:r0=0;
}
 P0@sg 0, wg 0, qf 0       | P1@sg 1, wg 1, qf 0       ;
 rmw.atom.qf.sc0 r0, x, 1  | st.atom.qf.sc0 x, 2       ;
 cbar.acq_rel.wg.semsc1 0  | cbar.acq_rel.wg.semsc1 0  ;

exists (P0:r0 == 0 /\ x == 2)
