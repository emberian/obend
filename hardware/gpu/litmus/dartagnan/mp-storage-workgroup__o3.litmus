VULKAN mp-storage-workgroup
"obend-litmus-check: mp-storage-workgroup, the shape of hardware/gpu/litmus/wgsl/mp-storage-workgroup.wgsl"
{
x=0;
y=0;
P1:r0=0;
P1:r1=0;
}
 P0@sg 0, wg 0, qf 0       | P1@sg 1, wg 0, qf 0       ;
 st.atom.qf.sc0 x, 1       | ld.atom.qf.sc0 r0, y      ;
 st.atom.qf.sc0 y, 1       | ld.atom.qf.sc0 r1, x      ;
 cbar.acq_rel.wg.semsc1 0  | cbar.acq_rel.wg.semsc1 0  ;

exists (P1:r0 == 1 /\ P1:r1 == 1 /\ x == 1 /\ y == 1)
