VULKAN iriw
"obend-litmus-check: iriw, the shape of hardware/gpu/litmus/wgsl/iriw.wgsl"
{
x=0;
y=0;
P2:r0=0;
P2:r1=0;
P3:r0=0;
P3:r1=0;
}
 P0@sg 0, wg 0, qf 0   | P1@sg 1, wg 1, qf 0   | P2@sg 2, wg 2, qf 0   | P3@sg 3, wg 3, qf 0   ;
 st.atom.qf.sc0 x, 1   | st.atom.qf.sc0 y, 1   | ld.atom.qf.sc0 r0, x  | ld.atom.qf.sc0 r0, y  ;
                       |                       | ld.atom.qf.sc0 r1, y  | ld.atom.qf.sc0 r1, x  ;

exists (P2:r0 == 1 /\ P2:r1 == 0 /\ P3:r0 == 0 /\ P3:r1 == 0 /\ x == 1 /\ y == 1)
