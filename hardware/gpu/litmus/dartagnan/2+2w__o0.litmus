VULKAN 2+2w
"obend-litmus-check: 2+2w, the shape of hardware/gpu/litmus/wgsl/2+2w.wgsl"
{
x=0;
y=0;
}
 P0@sg 0, wg 0, qf 0       | P1@sg 1, wg 1, qf 0       ;
 st.atom.qf.sc0 x, 2       | st.atom.qf.sc0 y, 2       ;
 st.atom.qf.sc0 y, 1       | st.atom.qf.sc0 x, 1       ;
 cbar.acq_rel.wg.semsc1 0  | cbar.acq_rel.wg.semsc1 0  ;

exists (x == 2 /\ y == 1)
