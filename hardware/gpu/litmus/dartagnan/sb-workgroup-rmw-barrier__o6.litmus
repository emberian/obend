VULKAN sb-workgroup-rmw-barrier
"obend-litmus-check: sb-workgroup-rmw-barrier, the shape of hardware/gpu/litmus/wgsl/sb-workgroup-rmw-barrier.wgsl"
{
x=0;
y=0;
P0:r0=0;
P1:r0=0;
P1:r1=0;
}
 P0@sg 0, wg 0, qf 0           | P1@sg 1, wg 0, qf 0           ;
 st.atom.wg.sc1 x, 1           | cbar.acq_rel.wg.semsc1 0      ;
 cbar.acq_rel.wg.semsc1 0      | rmw.atom.wg.sc1 r0, y, 1      ;
 rmw.atom.wg.sc1.add r0, y, 0  | cbar.acq_rel.wg.semsc1 1      ;
 cbar.acq_rel.wg.semsc1 1      | ld.atom.wg.sc1 r1, x          ;
 cbar.acq_rel.wg.semsc1 2      | cbar.acq_rel.wg.semsc1 2      ;

exists (P0:r0 == 1 /\ P1:r0 == 1 /\ P1:r1 == 0 /\ x == 1 /\ y == 1)
