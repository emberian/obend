VULKAN corr-workgroup
"obend-litmus-check: corr-workgroup, the shape of hardware/gpu/litmus/wgsl/corr-workgroup.wgsl"
{
x=0;
P1:r0=0;
P1:r1=0;
}
 P0@sg 0, wg 0, qf 0   | P1@sg 1, wg 0, qf 0   ;
 st.atom.wg.sc1 x, 1   | ld.atom.wg.sc1 r0, x  ;
                       | ld.atom.wg.sc1 r1, x  ;

exists (P1:r0 == 0 /\ P1:r1 == 0 /\ x == 1)
