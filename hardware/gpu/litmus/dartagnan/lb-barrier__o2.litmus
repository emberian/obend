VULKAN lb-barrier
"obend-litmus-check: lb-barrier, the shape of hardware/gpu/litmus/wgsl/lb-barrier.wgsl"
{
y=0;
x=0;
P0:r0=0;
P1:r0=0;
}
 P0@sg 0, wg 0, qf 0       | P1@sg 1, wg 1, qf 0       ;
 ld.atom.qf.sc0 r0, y      | cbar.acq_rel.wg.semsc0 0  ;
 cbar.acq_rel.wg.semsc0 0  | ld.atom.qf.sc0 r0, x      ;
 st.atom.qf.sc0 x, 1       | cbar.acq_rel.wg.semsc0 1  ;
 cbar.acq_rel.wg.semsc0 1  | st.atom.qf.sc0 y, 1       ;

exists (P0:r0 == 1 /\ P1:r0 == 0 /\ y == 1 /\ x == 1)
