VULKAN sb-rmw-barrier
"obend-litmus-check: sb-rmw-barrier, the shape of hardware/gpu/litmus/wgsl/sb-rmw-barrier.wgsl"
{
x=0;
y=0;
P0:r0=0;
P1:r0=0;
P1:r1=0;
}
 P0@sg 0, wg 0, qf 0           | P1@sg 1, wg 1, qf 0           ;
 st.atom.qf.sc0 x, 1           | cbar.acq_rel.wg.semsc0 0      ;
 cbar.acq_rel.wg.semsc0 0      | rmw.atom.qf.sc0 r0, y, 1      ;
 rmw.atom.qf.sc0.add r0, y, 0  | cbar.acq_rel.wg.semsc0 1      ;
 cbar.acq_rel.wg.semsc0 1      | ld.atom.qf.sc0 r1, x          ;

exists (P0:r0 == 0 /\ P1:r0 == 0 /\ P1:r1 == 0 /\ x == 1 /\ y == 1)
