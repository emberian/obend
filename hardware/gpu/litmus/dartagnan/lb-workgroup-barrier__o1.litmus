VULKAN lb-workgroup-barrier
"obend-litmus-check: lb-workgroup-barrier, the shape of hardware/gpu/litmus/wgsl/lb-workgroup-barrier.wgsl"
{
y=0;
x=0;
P0:r0=0;
P1:r0=0;
}
 P0@sg 0, wg 0, qf 0       | P1@sg 1, wg 0, qf 0       ;
 ld.atom.wg.sc1 r0, y      | cbar.acq_rel.wg.semsc1 0  ;
 cbar.acq_rel.wg.semsc1 0  | ld.atom.wg.sc1 r0, x      ;
 st.atom.wg.sc1 x, 1       | cbar.acq_rel.wg.semsc1 1  ;
 cbar.acq_rel.wg.semsc1 1  | st.atom.wg.sc1 y, 1       ;
 cbar.acq_rel.wg.semsc1 2  | cbar.acq_rel.wg.semsc1 2  ;

exists (P0:r0 == 0 /\ P1:r0 == 1 /\ y == 1 /\ x == 1)
