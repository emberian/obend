VULKAN mp-storage-workgroup-barrier
"obend-litmus-check: mp-storage-workgroup-barrier, the shape of hardware/gpu/litmus/wgsl/mp-storage-workgroup-barrier.wgsl"
{
x=0;
y=0;
P1:r0=0;
P1:r1=0;
}
 P0@sg 0, wg 0, qf 0       | P1@sg 1, wg 0, qf 0       ;
 st.atom.qf.sc0 x, 1       | cbar.acq_rel.wg.semsc0 0  ;
 cbar.acq_rel.wg.semsc0 0  | ld.atom.qf.sc0 r0, y      ;
 st.atom.qf.sc0 y, 1       | cbar.acq_rel.wg.semsc0 1  ;
 cbar.acq_rel.wg.semsc0 1  | ld.atom.qf.sc0 r1, x      ;
 cbar.acq_rel.wg.semsc1 2  | cbar.acq_rel.wg.semsc1 2  ;

exists (P1:r0 == 0 /\ P1:r1 == 0 /\ x == 1 /\ y == 1)
