VULKAN barrier-store-load
"obend-litmus-check: barrier-store-load, the shape of hardware/gpu/litmus/wgsl/barrier-store-load.wgsl"
{
x=0;
P1:r0=0;
}
 P0@sg 0, wg 0, qf 0       | P1@sg 1, wg 0, qf 0       ;
 st.av.wg.sc1 x, 1         | cbar.acq_rel.wg.semsc1 0  ;
 cbar.acq_rel.wg.semsc1 0  | ld.vis.wg.sc1 r0, x       ;
 cbar.acq_rel.wg.semsc1 1  | cbar.acq_rel.wg.semsc1 1  ;

exists (P1:r0 == 1)
