VULKAN lb-workgroup
"obend-litmus-check: lb-workgroup, the shape of hardware/gpu/litmus/wgsl/lb-workgroup.wgsl"
{
y=0;
x=0;
P0:r0=0;
P1:r0=0;
}
 P0@sg 0, wg 0, qf 0       | P1@sg 1, wg 0, qf 0       ;
 ld.atom.wg.sc1 r0, y      | ld.atom.wg.sc1 r0, x      ;
 st.atom.wg.sc1 x, 1       | st.atom.wg.sc1 y, 1       ;
 cbar.acq_rel.wg.semsc1 0  | cbar.acq_rel.wg.semsc1 0  ;

exists (P0:r0 == 1 /\ P1:r0 == 0 /\ y == 1 /\ x == 1)
