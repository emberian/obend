VULKAN mp-workgroup
"obend-litmus-check: mp-workgroup, the shape of hardware/gpu/litmus/wgsl/mp-workgroup.wgsl"
{
x=0;
y=0;
P1:r0=0;
P1:r1=0;
}
 P0@sg 0, wg 0, qf 0   | P1@sg 1, wg 0, qf 0   ;
 st.atom.wg.sc1 x, 1   | ld.atom.wg.sc1 r0, y  ;
 st.atom.wg.sc1 y, 1   | ld.atom.wg.sc1 r1, x  ;

exists (P1:r0 == 1 /\ P1:r1 == 1 /\ x == 1 /\ y == 1)
