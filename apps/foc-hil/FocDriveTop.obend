edition ObjectiveBend 1
# Flagship App #2 (Top Level): Closed-Loop 20 kHz FOC Motor Drive & 6-Level SiC FCML HIL Controller
# Reference: QUALIFICATION-AND-SILICON-LEAN.md §4 App #2
#            Obend/Hardware/DigitalTwin.lean (sampled_data_current_loop_iss_contraction,
#                                             sampled_data_closed_loop_powertrain_safety_invariant)
#            Obend/Analysis/EqSatHypergraph.lean (statorCoupledLoss_adjoint_eqSat_sound)

import ./ClarkePark.obend as ClarkePark
import ./PiCurrentLoop.obend as PiLoop
import ./SicFcmlInverterLeg.obend as FcmlLeg

law monotone_hil_step: monotone(hilStepCounter)
law write_once_overtemp_gate_kill: writeOnce(overtempGateKill)
law bounded_dc_bus_voltage_v: new.dcBusVoltageV <= 1200

record FocDriveController:
  controlFreqKhz() -> Nat
  icapDprBandwidthGain() -> Nat
  statorThermalResPermille() -> Nat
  closedLoopVqMv(iqErrAmp: Nat) -> Nat
  activeFcmlBalanceMv(capErrMv: Nat) -> Nat
  statorWindingTempC(lossWatt: Nat) -> Nat

spec Nominal20kHzFocDrive for FocDriveController:
  requires controlFreqKhz() -> Nat
  requires icapDprBandwidthGain() -> Nat
  requires statorThermalResPermille() -> Nat
  def controlFreqKhz() -> Nat:
    20n
  def icapDprBandwidthGain() -> Nat:
    400n
  def statorThermalResPermille() -> Nat:
    5n
  def closedLoopVqMv(iqErrAmp: Nat) -> Nat:
    iqErrAmp * self.icapDprBandwidthGain + 250n
  def activeFcmlBalanceMv(capErrMv: Nat) -> Nat:
    capErrMv * 20n + 10n
  def statorWindingTempC(lossWatt: Nat) -> Nat:
    45n + lossWatt * self.statorThermalResPermille
  # SVPWM hexagon linear-modulation ceiling under ICAP DPR high-bandwidth override (`Kp = 480` mV/A):
  # up to 1200 A transient q-axis error, commanded `Vq = 480 * iqErr + 250` mV stays inside the 692.8 V
  # (`1200 V / sqrt(3) = 692820` mV) 1200 V DC-bus linear modulation limit (`law bounded_dc_bus_voltage_v`).
  claim icap_dpr_vq_svpwm_hexagon_bound(iqErrAmp: Nat) given iqErrAmp <= 1200n by judge("interval@1"): iqErrAmp * 480n + 250n <= 692820n
  # The DPR thermal-resistance upgrade (`5 -> 4` mK/W) extends the Class-H loss headroom at a 45 C
  # inlet from 27 kW to 33.75 kW: up to 33750 W the upgraded winding stays at or below 180 C
  # (in mC; the nominal 5 mK/W reaches 180 C at 27000 W).
  claim dpr_thermal_upgrade_extends_loss_headroom(lossWatt: Nat) given lossWatt <= 33750n by judge("interval@1"): 45000n + lossWatt * 4n <= 180000n
  # Below 14 kW of stator loss the in-slot winding (9 mK/W: 2 caloric + 5 convective + 2 wall,
  # FluidThermal.lean) stays under Class H at a 45 C coolant inlet. The box is the claim's own `given`;
  # a claim with no box is refused (AutoCert, 2026-11-04).
  claim stator_temp_interval_cbf(lossWatt: Nat) given lossWatt <= 14000n by judge("interval@1"): 45000n + lossWatt * 9n <= 180000n

spec IcapDprHighBandwidthFocOverride for FocDriveController:
  requires activeFcmlBalanceMv(capErrMv: Nat) -> Nat
  def icapDprBandwidthGain() -> Nat:
    480n
  def statorThermalResPermille() -> Nat:
    4n
  def activeFcmlBalanceMv(capErrMv: Nat) -> Nat:
    super.activeFcmlBalanceMv(capErrMv) + 15n
  claim icap_dpr_hotswap_boosts_vq_bandwidth() by weave: self.closedLoopVqMv(250n) == 120250n

def seedFocDrive() -> FocDriveController:
  {controlFreqKhz: 0n, icapDprBandwidthGain: 0n, statorThermalResPermille: 0n, closedLoopVqMv: fn(iq: Nat) -> Nat: 0n, activeFcmlBalanceMv: fn(ce: Nat) -> Nat: 0n, statorWindingTempC: fn(lw: Nat) -> Nat: 0n}

def nominalFocDrive() -> FocDriveController:
  fix(Nominal20kHzFocDrive, seedFocDrive())

def icapDprHotSwappedFocDrive() -> FocDriveController:
  fix(compose(Nominal20kHzFocDrive, IcapDprHighBandwidthFocOverride), seedFocDrive())

def fullHilClosedLoopDiagnosticMv() -> Nat:
  icapDprHotSwappedFocDrive().closedLoopVqMv(250n) + FcmlLeg.unbalanced15vRecoveryStepMv() + ClarkePark.ratedDirectAxisCurrentMa() + PiLoop.ratedStepVqCommandMv()
