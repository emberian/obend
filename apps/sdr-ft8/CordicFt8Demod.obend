edition ObjectiveBend 1
# Flagship App #3 (Layer 3): 4-Stage Unrolled CORDIC atan2/hypot & Stateful Delta-Phase FT8 Discriminator
# Reference: Obend/Hardware/DSP.lean (cordic_4stage_pipeline_verified, goldenCordic4Stages)

import ./CicDecimatorFir.obend as CicFir

law monotone_ft8_symbol_idx: monotone(ft8SymbolCounter)
law bounded_ft8_tone_bin: new.ft8ToneBin <= 7

record CordicFt8Demodulator:
  cordicGainPermille() -> Nat
  ft8ToneSpacingMilliHz() -> Nat
  cordicEnvelopeMag(iVal: Nat) -> Nat
  alwaysFfDeltaPhaseMrad(phaseMrad: Nat) -> Nat
  ft8SymbolBin(deltaPhaseMrad: Nat) -> Nat

spec BaseCordicFt8Spec for CordicFt8Demodulator:
  requires cordicGainPermille() -> Nat
  requires ft8ToneSpacingMilliHz() -> Nat
  def cordicGainPermille() -> Nat:
    1600n
  def ft8ToneSpacingMilliHz() -> Nat:
    6250n
  def cordicEnvelopeMag(iVal: Nat) -> Nat:
    iVal * self.cordicGainPermille + 10n
  def alwaysFfDeltaPhaseMrad(phaseMrad: Nat) -> Nat:
    phaseMrad * 2n + 3n
  def ft8SymbolBin(deltaPhaseMrad: Nat) -> Nat:
    deltaPhaseMrad * self.ft8ToneSpacingMilliHz + 7n
  # Unrolled CORDIC pseudo-rotation gain factor (`x' = x - y/2^k`, `y' = y + x/2^k`, scaled by `2^k = s`):
  # `(s*x - y)^2 + (s*y + x)^2 == (s^2 + 1) * (x^2 + y^2)`, written without subtraction via `xRot + y == s * x`.
  claim cordic_microrotation_norm_scaling(x: Nat, y: Nat, s: Nat, xRot: Nat) given xRot + y == s * x by judge("groebner@1"): xRot * xRot + (s * y + x) * (s * y + x) == (s * s + 1n) * (x * x + y * y)
  # FT8 8-FSK bandwidth invariant: 8 tones spaced at 6250 mHz span `7 * 6250 == 43750` mHz, fitting
  # strictly inside a standard 50000 mHz (50 Hz) HF FT8 sub-band channel with 6250 mHz guard band.
  claim ft8_8fsk_occupied_bandwidth_fits_50hz(toneIdx: Nat) given toneIdx <= 7n by judge("interval@1"): toneIdx * 6250n + 6250n <= 50000n
  # FT8's eight tones at 6.25 Hz spacing, seen by the lag-2 discriminator at the CIC's output rate
  # 12000/64 = 187.5 samples/s: tone k turns the lag-2 product by k*2pi/15 rad = k*418879 urad. Each
  # tone's decision region is half a spacing (209438 urad, less the threshold rounding) either side;
  # this claim is that the top tone's region still ends below pi (3141593 urad), so the eight regions
  # fit in the discriminator's unambiguous range and no tone aliases into another. The slicer that
  # realises the regions is Obend.Apps.SdrFt8Rx.binExpr (in sdrFt8DiscModule, emitted as
  # verilator/sdr_ft8_disc.sv); binExpr_correct, ft8_bin_of_tone and ft8_bin_range are its theorems.
  claim ft8_tone_regions_below_pi(k: Nat) given k <= 7n by judge("interval@1"): k * 418879n + 209438n <= 3141593n

spec Unrolled4StageCordicFt8Override for CordicFt8Demodulator:
  requires alwaysFfDeltaPhaseMrad(phaseMrad: Nat) -> Nat
  def cordicGainPermille() -> Nat:
    1646n
  def ft8ToneSpacingMilliHz() -> Nat:
    6250n
  def alwaysFfDeltaPhaseMrad(phaseMrad: Nat) -> Nat:
    super.alwaysFfDeltaPhaseMrad(phaseMrad) + 2n
  claim unrolled_4stage_cordic_gain_1646() by weave: self.cordicEnvelopeMag(80n) == 131690n

record CordicStatefulDiscrim:
  cicScaleSample(usbMv: Nat) -> Nat
  alwaysFfNextCicInt1(cicInt1: Nat, prevPhaseMrad: Nat, usbSampleMv: Nat, phaseMrad: Nat) -> Nat
  alwaysFfNextPrevPhase(cicInt1: Nat, prevPhaseMrad: Nat, usbSampleMv: Nat, phaseMrad: Nat) -> Nat
  alwaysFfOutDeltaPhase(cicInt1: Nat, prevPhaseMrad: Nat, usbSampleMv: Nat, phaseMrad: Nat) -> Nat

spec NominalCordicStatefulSpec for CordicStatefulDiscrim:
  requires cicScaleSample(usbMv: Nat) -> Nat
  def cicScaleSample(usbMv: Nat) -> Nat:
    usbMv * 1n
  def alwaysFfNextCicInt1(cicInt1: Nat, prevPhaseMrad: Nat, usbSampleMv: Nat, phaseMrad: Nat) -> Nat:
    cicInt1 + self.cicScaleSample(usbSampleMv)
  def alwaysFfNextPrevPhase(cicInt1: Nat, prevPhaseMrad: Nat, usbSampleMv: Nat, phaseMrad: Nat) -> Nat:
    phaseMrad
  def alwaysFfOutDeltaPhase(cicInt1: Nat, prevPhaseMrad: Nat, usbSampleMv: Nat, phaseMrad: Nat) -> Nat:
    phaseMrad - prevPhaseMrad

spec CalibratedCordicStatefulOverride for CordicStatefulDiscrim:
  def cicScaleSample(usbMv: Nat) -> Nat:
    usbMv * 2n

def seedCordicFt8Demod() -> CordicFt8Demodulator:
  {cordicGainPermille: 0n, ft8ToneSpacingMilliHz: 0n, cordicEnvelopeMag: fn(iv: Nat) -> Nat: 0n, alwaysFfDeltaPhaseMrad: fn(pm: Nat) -> Nat: 0n, ft8SymbolBin: fn(dp: Nat) -> Nat: 0n}

def seedCordicStatefulDiscrim() -> CordicStatefulDiscrim:
  {cicScaleSample: fn(u: Nat) -> Nat: 0n, alwaysFfNextCicInt1: fn(c1: Nat, pp: Nat, us: Nat, pm: Nat) -> Nat: 0n, alwaysFfNextPrevPhase: fn(c1: Nat, pp: Nat, us: Nat, pm: Nat) -> Nat: 0n, alwaysFfOutDeltaPhase: fn(c1: Nat, pp: Nat, us: Nat, pm: Nat) -> Nat: 0n}

def baseCordicFt8Demod() -> CordicFt8Demodulator:
  fix(BaseCordicFt8Spec, seedCordicFt8Demod())

def unrolled4StageCordicFt8Demod() -> CordicFt8Demodulator:
  fix(compose(BaseCordicFt8Spec, Unrolled4StageCordicFt8Override), seedCordicFt8Demod())

def calibratedCordicStatefulDiscrim() -> CordicStatefulDiscrim:
  fix(compose(NominalCordicStatefulSpec, CalibratedCordicStatefulOverride), seedCordicStatefulDiscrim())

def ratedFt8SymbolMetric() -> Nat:
  unrolled4StageCordicFt8Demod().cordicEnvelopeMag(80n) + baseCordicFt8Demod().cordicGainPermille() + calibratedCordicStatefulDiscrim().alwaysFfOutDeltaPhase(0n, 100n, 500n, 350n) + CicFir.ratedDecimatedFirSample()

