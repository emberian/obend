edition ObjectiveBend 1
# Flagship App #3 (Top Level): All-Digital 40m (7.074 MHz) Tayloe IQ FT8 SDR Transceiver
# Reference: QUALIFICATION-AND-SILICON-LEAN.md §4 App #3
#            Obend/Hardware/RF.lean (tayloe_iq_cancels_image_sideband, rf_transceiver_signoff_poles)
#            Obend/Hardware/DSP.lean (sdrDdcChain_signoff_sound, cordic_4stage_pipeline_verified)

import ./TayloeQuadratureMixer.obend as Tayloe
import ./CicDecimatorFir.obend as CicFir
import ./CordicFt8Demod.obend as CordicDemod

law monotone_sdr_sample_tick: monotone(sdrSampleCounter)
law write_once_pa_vswr_trip: writeOnce(paVswrTripLatch)
law bounded_image_rejection_db: new.imageRejectionDb <= 90

record SdrFt8Transceiver:
  carrierFreqKhz() -> Nat
  imageRejectionDb() -> Nat
  friisNoiseFactorMilli() -> Nat
  ddcFilteredMag(rfMv: Nat) -> Nat
  demodFt8SymbolStream(rfMv: Nat) -> Nat
  rxSensitivityMarginDb(snrDb: Nat) -> Nat

spec Nominal40mSdrFt8Transceiver for SdrFt8Transceiver:
  requires carrierFreqKhz() -> Nat
  requires imageRejectionDb() -> Nat
  requires friisNoiseFactorMilli() -> Nat
  def carrierFreqKhz() -> Nat:
    7074n
  def imageRejectionDb() -> Nat:
    62n
  def friisNoiseFactorMilli() -> Nat:
    1450n
  def ddcFilteredMag(rfMv: Nat) -> Nat:
    rfMv * 8n + 16n
  def demodFt8SymbolStream(rfMv: Nat) -> Nat:
    rfMv * self.imageRejectionDb + 1250n
  def rxSensitivityMarginDb(snrDb: Nat) -> Nat:
    snrDb * 10n + self.friisNoiseFactorMilli
  # Friis cascade, in noise-excess form `e = F - 1` (`e_ab = e_a + e_b / G_a`), is associative:
  # folding stages 2 and 3 first (`g2 * e23 == g2 * e2 + e3`) and then putting the LNA in front
  # (`g1 * e123 == g1 * e1 + e23`) gives the three-stage formula
  # `e123 = e1 + e2 / g1 + e3 / (g1 * g2)`, written cleared of denominators. Each later stage's excess
  # is divided by all the gain ahead of it.
  claim friis_cascade_lna_noise_suppression(g1: Nat, g2: Nat, e1: Nat, e2: Nat, e3: Nat, e23: Nat, e123: Nat) given g2 * e23 == g2 * e2 + e3 && g1 * e123 == g1 * e1 + e23 by judge("groebner@1"): (g1 * g2) * e123 == (g1 * g2) * e1 + g2 * e2 + e3
  # Sideband amplitudes of an I/Q pair with branch gains `gI`, `gQ`: the wanted sideband is
  # `gI + gQ` and the image `m == gI - gQ` (written `m + gQ == gI`), so the wanted power exceeds the
  # image power by exactly `4 * gI * gQ`; the image vanishes only when the gain trim equalises them.
  claim iq_sideband_power_difference(gI: Nat, gQ: Nat, m: Nat) given m + gQ == gI by judge("groebner@1"): (gI + gQ) * (gI + gQ) == m * m + 4n * gI * gQ
  # Image rejection after calibration. The I/Q gain trim steps 1/500 and the phase trim 2 mrad, so the
  # residual gain error is at most 1000 ppm (a) and the residual phase error at most 1 mrad, for which
  # 1 - cos(phi) <= 500001e-12 (w; the taylor-model@1 enclosure of cos over [-1/1000, 1/1000]). With
  # u = g - 1 (|u| = a 1e-6) and v = 1 - cos(phi) (v = w 1e-12) the wanted sideband's power is
  # (2+u)^2 - 2(1+u)v and the image's u^2 + 2(1+u)v (times the same constant); scaled by 1e18 and with
  # each term at its worst sign, this claim is image * 1995263 <= wanted, i.e. an image rejection ratio
  # above 10^6.3, 63 dB, 3 dB more than the 60 dB a signal 40 dB stronger on the image frequency needs
  # to land 20 dB below the wanted one. Obend.Apps.SdrFt8Rx.sdr_irr_ge_63dB proves the same with the
  # standard formula over the rationals (interval@1 for the ratio, taylor-model@1 for cos).
  claim rx_image_rejection_63db(a: Nat, w: Nat) given a <= 1000n && w <= 500001n by judge("interval@1"): 1995263n * (a * a * 1000000n + 2n * (1000000n + a) * w) + 2n * (1000000n + a) * w + 4000000000000n * a <= 4000000000000000000n + a * a * 1000000n

spec Calibrated40mFt8TransceiverOverride for SdrFt8Transceiver:
  requires ddcFilteredMag(rfMv: Nat) -> Nat
  def imageRejectionDb() -> Nat:
    68n
  def friisNoiseFactorMilli() -> Nat:
    1410n
  def ddcFilteredMag(rfMv: Nat) -> Nat:
    super.ddcFilteredMag(rfMv) + 12n
  claim calibrated_40m_transceiver_boosts_irr() by weave: self.demodFt8SymbolStream(100n) == 8050n

def seedSdrFt8Transceiver() -> SdrFt8Transceiver:
  {carrierFreqKhz: 0n, imageRejectionDb: 0n, friisNoiseFactorMilli: 0n, ddcFilteredMag: fn(rf: Nat) -> Nat: 0n, demodFt8SymbolStream: fn(rf: Nat) -> Nat: 0n, rxSensitivityMarginDb: fn(sn: Nat) -> Nat: 0n}

def nominal40mSdrFt8() -> SdrFt8Transceiver:
  fix(Nominal40mSdrFt8Transceiver, seedSdrFt8Transceiver())

def calibrated40mSdrFt8() -> SdrFt8Transceiver:
  fix(compose(Nominal40mSdrFt8Transceiver, Calibrated40mFt8TransceiverOverride), seedSdrFt8Transceiver())

def fullSdrFt8DiagnosticMetric() -> Nat:
  calibrated40mSdrFt8().demodFt8SymbolStream(100n) + CordicDemod.ratedFt8SymbolMetric() + CicFir.ratedDecimatedFirSample() + Tayloe.rated40mImageCancelMv()
