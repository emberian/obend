edition ObjectiveBend 1
# apps/fidget-cam/BaseImpellerBody.obend: the hub of the fidget part, in micrometres.
# `Obend.Apps.FidgetCam` reads these values and builds the solid (`FRepExpr`) from them; the
# geometry is not restated in Lean. The override is a stronger opinion on the hub height, the way a
# local layer overrides a referenced one in USD: the composed object is what the CAM tier machines.

record ImpellerBody:
  hubRadiusUm() -> Nat
  hubHeightUm() -> Nat
  hubCentreXUm() -> Nat
  hubTopUm(baseUm: Nat) -> Nat

spec BaseImpellerSubLayerSpec for ImpellerBody:
  requires hubHeightUm() -> Nat
  def hubRadiusUm() -> Nat:
    10000n
  def hubHeightUm() -> Nat:
    6000n
  def hubCentreXUm() -> Nat:
    0n
  def hubTopUm(baseUm: Nat) -> Nat:
    baseUm + self.hubHeightUm
  claim hub_top_follows_height(baseUm: Nat): self.hubTopUm(baseUm) == baseUm + self.hubHeightUm

spec HighSpeedShroudOverride for ImpellerBody:
  requires hubHeightUm() -> Nat
  def hubHeightUm() -> Nat:
    8000n

def seedImpellerBody() -> ImpellerBody:
  {hubRadiusUm: 0n, hubHeightUm: 0n, hubCentreXUm: 0n, hubTopUm: fn(b: Nat) -> Nat: b}

def baseImpellerBody() -> ImpellerBody:
  fix(BaseImpellerSubLayerSpec, seedImpellerBody())

def shroudedImpellerBody() -> ImpellerBody:
  fix(compose(BaseImpellerSubLayerSpec, HighSpeedShroudOverride), seedImpellerBody())

def hubRadius() -> Nat:
  shroudedImpellerBody().hubRadiusUm

def hubHeight() -> Nat:
  shroudedImpellerBody().hubHeightUm

def hubTopAtZero() -> Nat:
  shroudedImpellerBody().hubTopUm(0n)
