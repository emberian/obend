edition ObjectiveBend 1
# apps/fidget-cam/MountingBossAssembly.obend: the mounting lug on the hub rim, in micrometres.
# The lug is a cylinder parallel to Z at X = lugCentreXUm, Y = 0, as tall as the hub; the stiffened
# variant is a stronger opinion on its radius.

import ./BaseImpellerBody.obend as BaseBody

record MountingBossLug:
  lugCentreXUm() -> Nat
  lugRadiusUm() -> Nat
  lugReachUm() -> Nat

spec PayloadBossArcSpec for MountingBossLug:
  requires lugRadiusUm() -> Nat
  def lugCentreXUm() -> Nat:
    10000n
  def lugRadiusUm() -> Nat:
    2000n
  def lugReachUm() -> Nat:
    self.lugCentreXUm + self.lugRadiusUm
  claim lug_reach_is_centre_plus_radius(): self.lugReachUm() == self.lugCentreXUm + self.lugRadiusUm

spec VariantStiffenedBossOverride for MountingBossLug:
  requires lugRadiusUm() -> Nat
  def lugRadiusUm() -> Nat:
    2500n

def seedMountingBoss() -> MountingBossLug:
  {lugCentreXUm: 0n, lugRadiusUm: 0n, lugReachUm: 0n}

def payloadMountingBoss() -> MountingBossLug:
  fix(PayloadBossArcSpec, seedMountingBoss())

def stiffenedMountingBoss() -> MountingBossLug:
  fix(compose(PayloadBossArcSpec, VariantStiffenedBossOverride), seedMountingBoss())

def lugCentreX() -> Nat:
  stiffenedMountingBoss().lugCentreXUm

def lugRadius() -> Nat:
  stiffenedMountingBoss().lugRadiusUm

def lugReach() -> Nat:
  stiffenedMountingBoss().lugReachUm
