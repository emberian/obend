edition ObjectiveBend 1
# apps/fidget-cam/ImpellerPartTop.obend: the process for the fidget part, in micrometres and
# machine units. It imports the three geometry modules so one package carries part and process.
# `Obend.Apps.FidgetCam` generates the tool path from these values, certifies it against the solid
# (`checkPathNoGouge_sound`) and posts it (`postNgc`, rotary-safe by `postMoves_rotarySafe`).

import ./BaseImpellerBody.obend as BaseBody
import ./CoolingChannelOverride.obend as Cooling
import ./MountingBossAssembly.obend as Boss

record ImpellerCamTop:
  latticeUm() -> Nat
  toolRadiusUm() -> Nat
  shankLengthUm() -> Nat
  stockAllowanceUm() -> Nat
  clearanceAboveTopUm() -> Nat
  stepDownUm() -> Nat
  cutFeedMmMin() -> Nat
  plungeFeedMmMin() -> Nat
  spindleRpm() -> Nat
  toolOffsetUm() -> Nat

spec OpenUsdSubLayerImpellerSpec for ImpellerCamTop:
  requires stockAllowanceUm() -> Nat
  def latticeUm() -> Nat:
    100n
  def toolRadiusUm() -> Nat:
    2000n
  def shankLengthUm() -> Nat:
    12000n
  def stockAllowanceUm() -> Nat:
    500n
  def clearanceAboveTopUm() -> Nat:
    5000n
  def stepDownUm() -> Nat:
    2000n
  def cutFeedMmMin() -> Nat:
    1200n
  def plungeFeedMmMin() -> Nat:
    300n
  def spindleRpm() -> Nat:
    18000n
  def toolOffsetUm() -> Nat:
    self.toolRadiusUm + self.stockAllowanceUm
  # Gouge-free roughing offset law (`checkPathNoGouge_sound`): for positive stock allowance `sUm >= 100` um
  # up to `1000` um on the 2000 um ball-nose cutter, roughing centreline offset `2000 + sUm` strictly
  # clears the finish surface (`>= 2100` um) while staying inside the `12000` um shank reach.
  claim roughing_offset_clears_finish_surface(sUm: Nat) given 100n <= sUm && sUm <= 1000n by judge("interval@1"): 2100n <= 2000n + sUm
  # Five 2000 um step-down passes plus the 400 um finish allowance (10400 um) are the most the
  # 12000 um shank reaches; a sixth pass (12400 um) would not fit.
  claim shank_reach_exceeds_stepdown_passes(passes: Nat) given passes <= 5n by judge("interval@1"): passes * 2000n + 400n <= 12000n

spec LiverpsLocalCamOverride for ImpellerCamTop:
  requires stockAllowanceUm() -> Nat
  def stockAllowanceUm() -> Nat:
    400n
  claim livrps_override_tightens_finish_offset() by weave: self.toolOffsetUm() == 2400n

def seedImpellerCamTop() -> ImpellerCamTop:
  {latticeUm: 0n, toolRadiusUm: 0n, shankLengthUm: 0n, stockAllowanceUm: 0n, clearanceAboveTopUm: 0n, stepDownUm: 0n, cutFeedMmMin: 0n, plungeFeedMmMin: 0n, spindleRpm: 0n, toolOffsetUm: 0n}

def subLayerImpellerCam() -> ImpellerCamTop:
  fix(OpenUsdSubLayerImpellerSpec, seedImpellerCamTop())

def liverpsImpellerCamTop() -> ImpellerCamTop:
  fix(compose(OpenUsdSubLayerImpellerSpec, LiverpsLocalCamOverride), seedImpellerCamTop())

def lattice() -> Nat:
  liverpsImpellerCamTop().latticeUm

def toolRadius() -> Nat:
  liverpsImpellerCamTop().toolRadiusUm

def shankLength() -> Nat:
  liverpsImpellerCamTop().shankLengthUm

def toolOffset() -> Nat:
  liverpsImpellerCamTop().toolOffsetUm

def clearanceAboveTop() -> Nat:
  liverpsImpellerCamTop().clearanceAboveTopUm

def stepDown() -> Nat:
  liverpsImpellerCamTop().stepDownUm

def cutFeed() -> Nat:
  liverpsImpellerCamTop().cutFeedMmMin

def plungeFeed() -> Nat:
  liverpsImpellerCamTop().plungeFeedMmMin

def spindle() -> Nat:
  liverpsImpellerCamTop().spindleRpm

