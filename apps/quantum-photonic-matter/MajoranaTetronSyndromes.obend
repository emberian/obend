edition ObjectiveBend 1
# Flagship App #8 (`apps/quantum-photonic-matter/MajoranaTetronSyndromes.obend`):
# Topological Majorana tetron (\gamma_0..\gamma_3) non-Abelian Clifford braiding
# and dissipative Lindblad fermion-parity cooling (L_cool(a) = \rho(\gamma_a) * \Pi_odd).

import ./ClementsKrawtchoukArray.obend as ClementsMod

record TetronSyndromeDecoder:
  majoranaZeroModes() -> Nat
  evenParityEigenvalue() -> Nat
  coolingPumpRateMHz() -> Nat
  braidGateDepth(cliffordWords: Nat) -> Nat
  syndromeRecoveryLatencyNs(oddPoisonEvents: Nat) -> Nat

spec BaseTetronBraidSpec for TetronSyndromeDecoder:
  requires coolingPumpRateMHz() -> Nat
  requires majoranaZeroModes() -> Nat
  def majoranaZeroModes() -> Nat:
    4n
  def evenParityEigenvalue() -> Nat:
    1n
  def coolingPumpRateMHz() -> Nat:
    120n
  def braidGateDepth(cliffordWords: Nat) -> Nat:
    cliffordWords * self.majoranaZeroModes + self.coolingPumpRateMHz
  def syndromeRecoveryLatencyNs(oddPoisonEvents: Nat) -> Nat:
    oddPoisonEvents * 16n + self.majoranaZeroModes
  # Concatenating two braid words about the same Majorana pair multiplies their rotors
  # `a + b * g` and `c + d * g` (`g^2 == -1`) into `r + (a * d + b * c) * g` with `r == a * c - b * d`
  # (written `r + b * d == a * c`), and the squared norms multiply: a concatenation of unitary braid
  # words is unitary (Brahmagupta-Fibonacci).
  claim tetron_braid_word_concat_preserves_norm(a: Nat, b: Nat, c: Nat, d: Nat, r: Nat) given r + b * d == a * c by judge("groebner@1"): r * r + (a * d + b * c) * (a * d + b * c) == (a * a + b * b) * (c * c + d * d)
  # Up to 16 odd-parity quasiparticle poisoning bursts, cooled recovery latency stays within a 280 ns cryo cycle.
  claim parity_cooling_recovery_cycle_bound(oddEvents: Nat) given oddEvents <= 16n by judge("interval@1"): oddEvents * 16n + 4n + 12n <= 280n

spec ParityCooledTetronOverride for TetronSyndromeDecoder:
  requires syndromeRecoveryLatencyNs(oddPoisonEvents: Nat) -> Nat
  def coolingPumpRateMHz() -> Nat:
    160n
  def syndromeRecoveryLatencyNs(oddPoisonEvents: Nat) -> Nat:
    super.syndromeRecoveryLatencyNs(oddPoisonEvents) + 12n
  claim parity_cooled_pump_updates_braid_budget() by weave: self.braidGateDepth(10n) == 200n

def seedTetronSyndromeDecoder() -> TetronSyndromeDecoder:
  {majoranaZeroModes: 0n, evenParityEigenvalue: 0n, coolingPumpRateMHz: 0n, braidGateDepth: fn(w: Nat) -> Nat: w, syndromeRecoveryLatencyNs: fn(e: Nat) -> Nat: e}

def baseTetronDecoder() -> TetronSyndromeDecoder:
  fix(BaseTetronBraidSpec, seedTetronSyndromeDecoder())

def parityCooledTetronDecoder() -> TetronSyndromeDecoder:
  fix(compose(BaseTetronBraidSpec, ParityCooledTetronOverride), seedTetronSyndromeDecoder())

def tetronBraidDepthAt10() -> Nat:
  parityCooledTetronDecoder().braidGateDepth(10n)

def tetronRecoveryAt3() -> Nat:
  parityCooledTetronDecoder().syndromeRecoveryLatencyNs(3n)

def crossModuleTetronKrawtchouk() -> Nat:
  ClementsMod.krawtchoukFidelityAt4() + tetronBraidDepthAt10()
