edition ObjectiveBend 1
# Flagship App #8 (`apps/quantum-photonic-matter/ClementsKrawtchoukArray.obend`):
# Planar Clements MZI interferometer & Krawtchouk Q_3 hypercube photonic state-transfer array
# with 1-WL quotient compression (8 -> 4 shells) and DPR guard fallback.

record KrawtchoukPhotonicBus:
  fullModes() -> Nat
  quotientShells() -> Nat
  krawtchoukCouplingLength0Nm() -> Nat
  krawtchoukCouplingLength1Nm() -> Nat
  krawtchoukCouplingLength2Nm() -> Nat
  quotientAdjointMacs(batchSize: Nat) -> Nat
  pstTransferFidelityPpm(stepIndex: Nat) -> Nat

spec BaseKrawtchoukBusSpec for KrawtchoukPhotonicBus:
  requires quotientShells() -> Nat
  requires krawtchoukCouplingLength2Nm() -> Nat
  def fullModes() -> Nat:
    8n
  def quotientShells() -> Nat:
    4n
  def krawtchoukCouplingLength0Nm() -> Nat:
    1571n
  def krawtchoukCouplingLength1Nm() -> Nat:
    2721n
  def krawtchoukCouplingLength2Nm() -> Nat:
    3142n
  def quotientAdjointMacs(batchSize: Nat) -> Nat:
    batchSize * self.quotientShells + self.krawtchoukCouplingLength2Nm
  def pstTransferFidelityPpm(stepIndex: Nat) -> Nat:
    stepIndex * 250n + 4n
  # 1-WL quotient compression (8 modes -> 4 Hamming shells) is a power contraction: collapsing the
  # three modes of a weight-1 (or weight-2) shell onto their symmetric representative keeps at most
  # the shell's power (`(a + b + c)^2 <= 3 * (a^2 + b^2 + c^2)`, equality on the symmetric state the
  # quotient walk lives in).
  claim wl_shell_projection_power_contraction(a: Nat, b: Nat, c: Nat) by judge("groebner@1"): (a + b + c) * (a + b + c) <= 3n * (a * a + b * b + c * c)
  # Krawtchouk perfect-state-transfer spectrum: for the 4-shell chain with squared couplings in the
  # ratio 3 : 4 : 3 (`a == 3 * e`, `b == 4 * e`; the lengths 1571 : 2721 : 3142 are 1 : sqrt(3) : 2),
  # the characteristic polynomial `x^2 - (2 * a + b) * x + a^2` in `x = lambda^2` vanishes at
  # `x = 9 * e` (and at `x = e`), so the eigenvalues are +-sqrt(e), +-3 * sqrt(e): equally spaced.
  claim krawtchouk_pst_spectrum_equally_spaced(e: Nat, a: Nat, b: Nat) given a == 3n * e && b == 4n * e by judge("groebner@1"): (9n * e) * (9n * e) + a * a == (2n * a + b) * (9n * e)

spec SymmetryPreservingKrawtchoukOverride for KrawtchoukPhotonicBus:
  requires pstTransferFidelityPpm(stepIndex: Nat) -> Nat
  def krawtchoukCouplingLength2Nm() -> Nat:
    3142n
  def pstTransferFidelityPpm(stepIndex: Nat) -> Nat:
    super.pstTransferFidelityPpm(stepIndex) + 1000n
  claim symmetry_override_lifts_pst_fidelity() by weave: self.pstTransferFidelityPpm(4n) == 2004n

def seedKrawtchoukPhotonicBus() -> KrawtchoukPhotonicBus:
  {fullModes: 0n, quotientShells: 0n, krawtchoukCouplingLength0Nm: 0n, krawtchoukCouplingLength1Nm: 0n, krawtchoukCouplingLength2Nm: 0n, quotientAdjointMacs: fn(b: Nat) -> Nat: b, pstTransferFidelityPpm: fn(s: Nat) -> Nat: s}

def baseKrawtchoukBus() -> KrawtchoukPhotonicBus:
  fix(BaseKrawtchoukBusSpec, seedKrawtchoukPhotonicBus())

def calibratedKrawtchoukBus() -> KrawtchoukPhotonicBus:
  fix(compose(BaseKrawtchoukBusSpec, SymmetryPreservingKrawtchoukOverride), seedKrawtchoukPhotonicBus())

def krawtchoukMacsAt16() -> Nat:
  calibratedKrawtchoukBus().quotientAdjointMacs(16n)

def krawtchoukFidelityAt4() -> Nat:
  calibratedKrawtchoukBus().pstTransferFidelityPpm(4n)
