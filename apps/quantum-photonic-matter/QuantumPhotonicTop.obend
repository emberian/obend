edition ObjectiveBend 1
# Flagship App #8 (`apps/quantum-photonic-matter/QuantumPhotonicTop.obend`):
# Top-level Quantum Photonic & Topological Matter Co-Processor integrating:
# - 1-WL quotient-compressed Q_3 Krawtchouk photonic bus (8 -> 4 shells),
# - 4x4 Faddeev-LeVerrier exact thermo-optic crosstalk pre-compensation (det = 8769),
# - Majorana tetron (\gamma_0..\gamma_3) non-Abelian Clifford braiding & Lindblad parity cooling.

import ./ClementsKrawtchoukArray.obend as ClementsMod
import ./ThermoOpticCrosstalkComp.obend as CrosstalkMod
import ./MajoranaTetronSyndromes.obend as TetronMod

law monotone_photonic_cal_epoch: monotone(photonicCalEpoch)
law bounded_disorder_leakage: new.disorderLeakagePpm <= 676
law monotone_heater_trim_step: monotone(heaterTrimStep)
law bounded_heater_power_mw: new.heaterPowerMw <= 120
law monotone_tetron_syndrome_cycle: monotone(syndromeCycle)
law preserve_fermion_parity_sector: writeOnce(fermionParitySector)
law write_once_chip_calibration_digest: writeOnce(chipCalibrationDigest)

record QuantumPhotonicCoProcessor:
  wlCompressedShells() -> Nat
  faddeevCrosstalkDet() -> Nat
  cmtKrawtchoukLength2Nm() -> Nat
  quotientReverseAdjointOps(batchVectors: Nat) -> Nat
  coProcessorCycleBudget(syndromeRounds: Nat) -> Nat

spec BaseQuantumPhotonicCoProcSpec for QuantumPhotonicCoProcessor:
  requires wlCompressedShells() -> Nat
  requires faddeevCrosstalkDet() -> Nat
  def wlCompressedShells() -> Nat:
    4n
  def faddeevCrosstalkDet() -> Nat:
    8769n
  def cmtKrawtchoukLength2Nm() -> Nat:
    3142n
  def quotientReverseAdjointOps(batchVectors: Nat) -> Nat:
    batchVectors * 4n + self.faddeevCrosstalkDet
  def coProcessorCycleBudget(syndromeRounds: Nat) -> Nat:
    syndromeRounds * 16n + 4n
  # Disorder leakage is second order in the coupler phase error: for an error up to 26 mrad the
  # leaked power `eps^2` (ppm) stays within `law bounded_disorder_leakage: new.disorderLeakagePpm <= 676`;
  # the bound is attained at 26 mrad.
  claim coproc_quadratic_disorder_leakage_within_law(epsMrad: Nat) given epsMrad <= 26n by judge("interval@1"): epsMrad * epsMrad <= 676n
  # Under `law bounded_heater_power_mw: new.heaterPowerMw <= 120` across 8 thermo-optic channels,
  # total mesh thermal budget stays within 960 mW package cryo dissipation limit.
  claim coproc_8channel_heater_cryo_budget(chPowerMw: Nat) given chPowerMw <= 120n by judge("interval@1"): 8n * chPowerMw <= 960n

spec FaultTolerantCoProcOverride for QuantumPhotonicCoProcessor:
  requires coProcessorCycleBudget(syndromeRounds: Nat) -> Nat
  def cmtKrawtchoukLength2Nm() -> Nat:
    3142n
  def coProcessorCycleBudget(syndromeRounds: Nat) -> Nat:
    super.coProcessorCycleBudget(syndromeRounds) + 32n
  claim fault_tolerant_override_extends_cycle_budget() by weave: self.coProcessorCycleBudget(6n) == 132n

def seedQuantumPhotonicCoProc() -> QuantumPhotonicCoProcessor:
  {wlCompressedShells: 0n, faddeevCrosstalkDet: 0n, cmtKrawtchoukLength2Nm: 0n, quotientReverseAdjointOps: fn(b: Nat) -> Nat: b, coProcessorCycleBudget: fn(r: Nat) -> Nat: r}

def baseQuantumPhotonicCoProc() -> QuantumPhotonicCoProcessor:
  fix(BaseQuantumPhotonicCoProcSpec, seedQuantumPhotonicCoProc())

def faultTolerantQuantumPhotonicCoProc() -> QuantumPhotonicCoProcessor:
  fix(compose(BaseQuantumPhotonicCoProcSpec, FaultTolerantCoProcOverride), seedQuantumPhotonicCoProc())

def coprocAdjointOpsAt25() -> Nat:
  faultTolerantQuantumPhotonicCoProc().quotientReverseAdjointOps(25n)

def coprocBudgetAt6() -> Nat:
  faultTolerantQuantumPhotonicCoProc().coProcessorCycleBudget(6n)

def crossModuleQpmSummary() -> Nat:
  ClementsMod.krawtchoukMacsAt16() + ClementsMod.krawtchoukFidelityAt4() + CrosstalkMod.precompDriveAt50() + TetronMod.tetronBraidDepthAt10() + coprocAdjointOpsAt25()
