edition ObjectiveBend 1
# Flagship App #4 (Layer 3): Stateful Multilinear Sumcheck Round Polynomial Accumulator, Folding Layer & Fiat-Shamir transcript
# This module carries no `claim`s (removed 2026-11-04): the importer proves each claim by kernel evaluation of the
# Core4 interpreter, and on this 64-bit arithmetic that took longer than the whole module's budget
# (review/DECISIONS-20261031.md, second round). The arithmetic is checked on the hardware instead
# (apps/zk-ntt/verilator: boundary vectors, 2048 butterflies and the 8-round sumcheck against a __uint128_t
# reference and the Lean golden), and at the Nat level by Obend.Apps.ZkNtt.goldilocksReduce128Spec_sound.
# transcriptAbsorb(t, g0, g1, g2) = (((t + g0) * 2^32 + g1) * 2^32 + g2 + 0x5A17)^7 over the field: the round
# challenge is this value, a fixed permutation of the running transcript and the prover's three messages
# (x^7 is a permutation of F_p since gcd(7, p - 1) = 1). It binds the challenge to the messages; it is not a
# cryptographic hash and makes no such claim.

import ./GoldilocksField.obend as Field
import ./NttButterflyRadix2.obend as Bfly

law monotone_sumcheck_round: monotone(sumcheckRoundIdx)

record SumcheckRoundTarget:
  goldilocksPrime() -> Nat
  numSumcheckRounds() -> Nat
  canon64(x: Nat) -> Nat
  fieldAdd(a: Nat, b: Nat) -> Nat
  fieldSub(a: Nat, b: Nat) -> Nat
  goldilocksReduce128(lo: Nat, hi: Nat) -> Nat
  fieldMul(a: Nat, b: Nat) -> Nat
  stepAccG0(accG0: Nat, f0: Nat, clear: Nat) -> Nat
  stepAccG1(accG1: Nat, f1: Nat, clear: Nat) -> Nat
  stepAccG2(accG2: Nat, f0: Nat, f1: Nat, clear: Nat) -> Nat
  sumcheckRoundClaim(accG0: Nat, accG1: Nat) -> Nat
  sumcheckFold(f0: Nat, f1: Nat, rChallenge: Nat) -> Nat
  transcriptAbsorb(t: Nat, g0: Nat, g1: Nat, g2: Nat) -> Nat

spec BaseSumcheckRoundSpec for SumcheckRoundTarget:
  requires goldilocksPrime() -> Nat
  requires numSumcheckRounds() -> Nat
  def goldilocksPrime() -> Nat:
    0xFFFFFFFF00000001n
  def numSumcheckRounds() -> Nat:
    8n
  def canon64(x: Nat) -> Nat:
    let w = x & 0xFFFFFFFFFFFFFFFFn in if self.goldilocksPrime <= w then w - self.goldilocksPrime else w
  def fieldAdd(a: Nat, b: Nat) -> Nat:
    let ca = self.canon64(a) in let cb = self.canon64(b) in let remP = self.goldilocksPrime - cb in if remP <= ca then ca - remP else ca + cb
  def fieldSub(a: Nat, b: Nat) -> Nat:
    let ca = self.canon64(a) in let cb = self.canon64(b) in if cb <= ca then ca - cb else (self.goldilocksPrime - cb) + ca
  def goldilocksReduce128(lo: Nat, hi: Nat) -> Nat:
    let hiLo = hi & 0xFFFFFFFFn in let hiHi = (hi >>> 32n) & 0xFFFFFFFFn in let mid = (hiLo << 32n) - hiLo in self.fieldSub(self.fieldAdd(lo, mid), hiHi)
  def fieldMul(a: Nat, b: Nat) -> Nat:
    let ca = self.canon64(a) in let cb = self.canon64(b) in let aLo = ca & 0xFFFFFFFFn in let aHi = (ca >>> 32n) & 0xFFFFFFFFn in let bLo = cb & 0xFFFFFFFFn in let bHi = (cb >>> 32n) & 0xFFFFFFFFn in let p00 = aLo * bLo in let p01 = aLo * bHi in let p10 = aHi * bLo in let p11 = aHi * bHi in let mid32 = ((p00 >>> 32n) & 0xFFFFFFFFn) + (p01 & 0xFFFFFFFFn) + (p10 & 0xFFFFFFFFn) in let lo = (p00 & 0xFFFFFFFFn) | ((mid32 & 0xFFFFFFFFn) << 32n) in let hi = p11 + ((p01 >>> 32n) & 0xFFFFFFFFn) + ((p10 >>> 32n) & 0xFFFFFFFFn) + (mid32 >>> 32n) in self.goldilocksReduce128(lo, hi)
  def stepAccG0(accG0: Nat, f0: Nat, clear: Nat) -> Nat:
    if clear == 1n then self.canon64(f0) else self.fieldAdd(accG0, f0)
  def stepAccG1(accG1: Nat, f1: Nat, clear: Nat) -> Nat:
    if clear == 1n then self.canon64(f1) else self.fieldAdd(accG1, f1)
  def stepAccG2(accG2: Nat, f0: Nat, f1: Nat, clear: Nat) -> Nat:
    let g2Term = self.fieldSub(self.fieldAdd(f1, f1), f0) in if clear == 1n then g2Term else self.fieldAdd(accG2, g2Term)
  def sumcheckRoundClaim(accG0: Nat, accG1: Nat) -> Nat:
    self.fieldAdd(accG0, accG1)
  def sumcheckFold(f0: Nat, f1: Nat, rChallenge: Nat) -> Nat:
    self.fieldAdd(f0, self.fieldMul(rChallenge, self.fieldSub(f1, f0)))
  def transcriptAbsorb(t: Nat, g0: Nat, g1: Nat, g2: Nat) -> Nat:
    let s = self.fieldAdd(self.fieldMul(self.fieldAdd(self.fieldMul(self.fieldAdd(t, g0), 0x100000000n), g1), 0x100000000n), self.fieldAdd(g2, 0x5A17n)) in let s2 = self.fieldMul(s, s) in let s4 = self.fieldMul(s2, s2) in self.fieldMul(self.fieldMul(s4, s2), s)

spec FusedSumcheckRoundOverride for SumcheckRoundTarget:
  requires canon64(x: Nat) -> Nat
  requires sumcheckFold(f0: Nat, f1: Nat, rChallenge: Nat) -> Nat
  def numSumcheckRounds() -> Nat:
    8n
  def sumcheckFold(f0: Nat, f1: Nat, rChallenge: Nat) -> Nat:
    if rChallenge == 0n then self.canon64(f0) else (if rChallenge == 1n then self.canon64(f1) else super.sumcheckFold(f0, f1, rChallenge))

def seedSumcheckRound() -> SumcheckRoundTarget:
  {goldilocksPrime: 0n, numSumcheckRounds: 0n, canon64: fn(x: Nat) -> Nat: 0n, fieldAdd: fn(a: Nat, b: Nat) -> Nat: 0n, fieldSub: fn(a: Nat, b: Nat) -> Nat: 0n, goldilocksReduce128: fn(lo: Nat, hi: Nat) -> Nat: 0n, fieldMul: fn(a: Nat, b: Nat) -> Nat: 0n, stepAccG0: fn(a: Nat, f: Nat, c: Nat) -> Nat: 0n, stepAccG1: fn(a: Nat, f: Nat, c: Nat) -> Nat: 0n, stepAccG2: fn(a: Nat, f0: Nat, f1: Nat, c: Nat) -> Nat: 0n, sumcheckRoundClaim: fn(a: Nat, b: Nat) -> Nat: 0n, sumcheckFold: fn(a: Nat, b: Nat, r: Nat) -> Nat: 0n, transcriptAbsorb: fn(t: Nat, a: Nat, b: Nat, c: Nat) -> Nat: 0n}

def sumcheckEngine() -> SumcheckRoundTarget:
  fix(compose(BaseSumcheckRoundSpec, FusedSumcheckRoundOverride), seedSumcheckRound())
