edition ObjectiveBend 1
# Flagship App #1 (Layer 2): Machine-Mode Privilege CSR Trap (ECALL), CSRRS Readback & Return (MRET) Override
# The claims that executed an instruction (execInstruction/execStep) were removed on 2026-11-04: the importer proves
# each claim by kernel evaluation of the Core4 interpreter and these took most of the module's budget
# (review/DECISIONS-20261031.md, second round); RV64I pipeline RTL execution is verified in
# Obend.Hardware.PipelinedRisc. The decode and pc claims stay.

import ./BaseRiscCore.obend as Base

law monotone_trap_epoch: monotone(trapEpoch)
law bounded_mcause_code: new.mcauseCode <= 31

record PrivilegeCsrTarget:
  mtvecAddr() -> Nat
  trapCauseCode() -> Nat
  stepPc(inst: Nat, pc: Nat, mepc: Nat) -> Nat
  aluExec(opcode: Nat, funct3: Nat, funct7: Nat, lhs: Nat, rhs: Nat) -> Nat
  execInstruction(inst: Nat, rs1Val: Nat, rs2Val: Nat) -> Nat

spec BaseUnprivilegedPcSpec for PrivilegeCsrTarget:
  requires mtvecAddr() -> Nat
  requires trapCauseCode() -> Nat
  def mtvecAddr() -> Nat:
    0x50n
  def trapCauseCode() -> Nat:
    11n
  def stepPc(inst: Nat, pc: Nat, mepc: Nat) -> Nat:
    (pc + 4n) & 0xFFFFFFFFFFFFFFFFn
  def aluExec(opcode: Nat, funct3: Nat, funct7: Nat, lhs: Nat, rhs: Nat) -> Nat:
    if funct3 == 0n then (if (opcode == 0x33n) && (funct7 == 0x20n) then ((lhs & 0xFFFFFFFFFFFFFFFFn) + ((rhs ^ 0xFFFFFFFFFFFFFFFFn) + 1n)) & 0xFFFFFFFFFFFFFFFFn else (if (opcode == 0x33n) && (funct7 == 0x01n) then (lhs * rhs) & 0xFFFFFFFFFFFFFFFFn else (lhs + rhs) & 0xFFFFFFFFFFFFFFFFn)) else (if funct3 == 2n then (if lhs <s rhs then 1n else 0n) else lhs & rhs)
  def execInstruction(inst: Nat, rs1Val: Nat, rs2Val: Nat) -> Nat:
    let op = inst & 0x7Fn in let f3 = (inst >>> 12n) & 0x7n in let f7 = (inst >>> 25n) & 0x7Fn in let immI = (inst << 32n) >> 52n in let rhs = if op == 0x13n then immI else rs2Val in self.aluExec(op, f3, f7, rs1Val, rhs)

spec PrivilegeCsrOverrideSpec for PrivilegeCsrTarget:
  requires mtvecAddr() -> Nat
  requires trapCauseCode() -> Nat
  requires stepPc(inst: Nat, pc: Nat, mepc: Nat) -> Nat
  requires execInstruction(inst: Nat, rs1Val: Nat, rs2Val: Nat) -> Nat
  def mtvecAddr() -> Nat:
    0x50n
  def trapCauseCode() -> Nat:
    11n
  def stepPc(inst: Nat, pc: Nat, mepc: Nat) -> Nat:
    let op = inst & 0x7Fn in let f3 = (inst >>> 12n) & 0x7n in let immU12 = (inst >>> 20n) & 0xFFFn in if (op == 0x73n) && (f3 == 0n) && (immU12 == 0n) then self.mtvecAddr else (if (op == 0x73n) && (f3 == 0n) && (immU12 == 0x302n) then mepc else super.stepPc(inst, pc, mepc))
  def execInstruction(inst: Nat, rs1Val: Nat, rs2Val: Nat) -> Nat:
    let op = inst & 0x7Fn in let f3 = (inst >>> 12n) & 0x7n in let immU12 = (inst >>> 20n) & 0xFFFn in if (op == 0x73n) && (f3 == 2n) then (if immU12 == 0x342n then self.trapCauseCode else self.mtvecAddr) else super.execInstruction(inst, rs1Val, rs2Val)
  claim priv_ecall_redirects_to_mtvec() by weave: self.stepPc(0x00000073n, 32n, 0n) == 0x50n
  claim priv_mret_restores_mepc() by weave: self.stepPc(0x30200073n, 88n, 36n) == 36n

def seedPrivilegeCsr() -> PrivilegeCsrTarget:
  {mtvecAddr: 0n, trapCauseCode: 0n, stepPc: fn(i: Nat, p: Nat, m: Nat) -> Nat: 0n, aluExec: fn(o: Nat, f3: Nat, f7: Nat, a: Nat, b: Nat) -> Nat: 0n, execInstruction: fn(i: Nat, a: Nat, b: Nat) -> Nat: 0n}

def privilegeRiscCore() -> PrivilegeCsrTarget:
  fix(compose(BaseUnprivilegedPcSpec, PrivilegeCsrOverrideSpec), seedPrivilegeCsr())
