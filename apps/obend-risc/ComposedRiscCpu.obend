edition ObjectiveBend 1
# Flagship App #1 (Top Level): 3-Layer Composed Open-Recursive RISC Softcore
# The claims that executed an instruction (execInstruction/execStep) were removed on 2026-11-04: the importer proves
# each claim by kernel evaluation of the Core4 interpreter and these took most of the module's budget
# (review/DECISIONS-20261031.md, second round); RV64I pipeline RTL execution is verified in
# Obend.Hardware.PipelinedRisc. The decode and pc claims stay.

import ./BaseRiscCore.obend as Base
import ./PrivilegeCsrOverride.obend as Priv
import ./CustomSimdZkExt.obend as Ext

law monotone_retired_insts: monotone(retiredInstCount)

record ComposedRiscCpuTarget:
  mtvecAddr() -> Nat
  trapCauseCode() -> Nat
  customExtOpcode() -> Nat
  decodeOpcode(inst: Nat) -> Nat
  decodeImmI(inst: Nat) -> Nat
  decodeImmS(inst: Nat) -> Nat
  aluExec(opcode: Nat, funct3: Nat, funct7: Nat, lhs: Nat, rhs: Nat) -> Nat
  extMacExec(funct3: Nat, funct7: Nat, rs1Val: Nat, rs2Val: Nat) -> Nat
  nextPc(inst: Nat, pc: Nat, mepc: Nat) -> Nat
  execStep(inst: Nat, rs1Val: Nat, rs2Val: Nat) -> Nat

spec Layer1BaseRiscSpec for ComposedRiscCpuTarget:
  requires mtvecAddr() -> Nat
  requires trapCauseCode() -> Nat
  requires customExtOpcode() -> Nat
  def mtvecAddr() -> Nat:
    0x50n
  def trapCauseCode() -> Nat:
    11n
  def customExtOpcode() -> Nat:
    0x2Bn
  def decodeOpcode(inst: Nat) -> Nat:
    inst & 0x7Fn
  def decodeImmI(inst: Nat) -> Nat:
    (inst << 32n) >> 52n
  def decodeImmS(inst: Nat) -> Nat:
    let rawS = (((inst >>> 25n) & 0x7Fn) << 5n) | ((inst >>> 7n) & 0x1Fn) in (rawS << 52n) >> 52n
  def aluExec(opcode: Nat, funct3: Nat, funct7: Nat, lhs: Nat, rhs: Nat) -> Nat:
    if funct3 == 0n then (if (opcode == 0x33n) && (funct7 == 0x20n) then ((lhs & 0xFFFFFFFFFFFFFFFFn) + ((rhs ^ 0xFFFFFFFFFFFFFFFFn) + 1n)) & 0xFFFFFFFFFFFFFFFFn else (if (opcode == 0x33n) && (funct7 == 0x01n) then (lhs * rhs) & 0xFFFFFFFFFFFFFFFFn else (lhs + rhs) & 0xFFFFFFFFFFFFFFFFn)) else (if funct3 == 1n then lhs << (rhs & 0x3Fn) else (if funct3 == 2n then (if lhs <s rhs then 1n else 0n) else (if funct3 == 4n then lhs ^ rhs else (if funct3 == 5n then (if funct7 == 0x20n then lhs >> (rhs & 0x3Fn) else lhs >>> (rhs & 0x3Fn)) else (if funct3 == 6n then lhs | rhs else lhs & rhs)))))
  def extMacExec(funct3: Nat, funct7: Nat, rs1Val: Nat, rs2Val: Nat) -> Nat:
    if funct3 == 0n then ((rs1Val * rs2Val) + funct7) & 0xFFFFFFFFFFFFFFFFn else (((rs1Val & 0xFFFFFFFFn) << 32n) - (rs1Val & 0xFFFFFFFFn) + rs2Val) & 0xFFFFFFFFFFFFFFFFn
  def nextPc(inst: Nat, pc: Nat, mepc: Nat) -> Nat:
    (pc + 4n) & 0xFFFFFFFFFFFFFFFFn
  def execStep(inst: Nat, rs1Val: Nat, rs2Val: Nat) -> Nat:
    let op = inst & 0x7Fn in let f3 = (inst >>> 12n) & 0x7n in let f7 = (inst >>> 25n) & 0x7Fn in let immI = (inst << 32n) >> 52n in let rhs = if op == 0x13n then immI else rs2Val in self.aluExec(op, f3, f7, rs1Val, rhs)

spec Layer2PrivCsrOverride for ComposedRiscCpuTarget:
  requires mtvecAddr() -> Nat
  requires trapCauseCode() -> Nat
  requires nextPc(inst: Nat, pc: Nat, mepc: Nat) -> Nat
  requires execStep(inst: Nat, rs1Val: Nat, rs2Val: Nat) -> Nat
  def mtvecAddr() -> Nat:
    0x50n
  def trapCauseCode() -> Nat:
    11n
  def nextPc(inst: Nat, pc: Nat, mepc: Nat) -> Nat:
    let op = inst & 0x7Fn in let f3 = (inst >>> 12n) & 0x7n in let immU12 = (inst >>> 20n) & 0xFFFn in if (op == 0x73n) && (f3 == 0n) && (immU12 == 0n) then self.mtvecAddr else (if (op == 0x73n) && (f3 == 0n) && (immU12 == 0x302n) then mepc else super.nextPc(inst, pc, mepc))
  def execStep(inst: Nat, rs1Val: Nat, rs2Val: Nat) -> Nat:
    let op = inst & 0x7Fn in let f3 = (inst >>> 12n) & 0x7n in let immU12 = (inst >>> 20n) & 0xFFFn in if (op == 0x73n) && (f3 == 2n) then (if immU12 == 0x342n then self.trapCauseCode else self.mtvecAddr) else super.execStep(inst, rs1Val, rs2Val)

spec Layer3CustomSimdZkOverride for ComposedRiscCpuTarget:
  requires customExtOpcode() -> Nat
  requires extMacExec(funct3: Nat, funct7: Nat, rs1Val: Nat, rs2Val: Nat) -> Nat
  requires nextPc(inst: Nat, pc: Nat, mepc: Nat) -> Nat
  requires execStep(inst: Nat, rs1Val: Nat, rs2Val: Nat) -> Nat
  def customExtOpcode() -> Nat:
    0x2Bn
  def execStep(inst: Nat, rs1Val: Nat, rs2Val: Nat) -> Nat:
    let op = inst & 0x7Fn in let f3 = (inst >>> 12n) & 0x7n in let f7 = (inst >>> 25n) & 0x7Fn in if op == self.customExtOpcode then self.extMacExec(f3, f7, rs1Val, rs2Val) else super.execStep(inst, rs1Val, rs2Val)
  claim composed_trap_preempts_pc() by weave: self.nextPc(0x00000073n, 32n, 0n) == 0x50n
  claim composed_mret_restores_mepc() by weave: self.nextPc(0x30200073n, 88n, 36n) == 36n

def seedComposedRiscCpu() -> ComposedRiscCpuTarget:
  {mtvecAddr: 0n, trapCauseCode: 0n, customExtOpcode: 0n, decodeOpcode: fn(i: Nat) -> Nat: 0n, decodeImmI: fn(i: Nat) -> Nat: 0n, decodeImmS: fn(i: Nat) -> Nat: 0n, aluExec: fn(o: Nat, f3: Nat, f7: Nat, a: Nat, b: Nat) -> Nat: 0n, extMacExec: fn(f3: Nat, f7: Nat, a: Nat, b: Nat) -> Nat: 0n, nextPc: fn(i: Nat, p: Nat, m: Nat) -> Nat: 0n, execStep: fn(i: Nat, a: Nat, b: Nat) -> Nat: 0n}

def composedRiscCpu() -> ComposedRiscCpuTarget:
  fix(compose(compose(Layer1BaseRiscSpec, Layer2PrivCsrOverride), Layer3CustomSimdZkOverride), seedComposedRiscCpu())
